############################################################
# Infrabyx LawDocs (LD) — environment template · LawDocs Build Prompt Pack v1.1 (26 October 2026)
# Derived from IPB-11 §11.4.3 (196-variable group template) — only the variables LawDocs uses, plus LD_* product variables.
# Variables for optional secondary adapters (Vault, Unleash, Azure Speech, Google/Microsoft calendar secrets, APNs, OpenAI direct,
# DSC, GSTIN, ODR, accounting) are added by `pnpm env:example` when the adapter is enabled in provider_routing; they are omitted here.
# Generated in the repository by `pnpm env:example`; this file is the pack's reference copy. Do not edit the generated file by hand.
# Columns in each comment: description · req: (all | nonprod | prod | opt) · sens: S secret / C config / P public (browser-exposed).
# Secrets (sens:S) MUST be `secret://` references in staging, pre-prod, prod and dr (IPB-11-12); a literal secret in those
# environments fails boot. Production refuses every SEED_* variable (IPB-D-04). Node.js 24.22.1 (IPB-D-01).
############################################################

# ---------- APP_ (process identity, URLs) ----------
APP_ENV=local                                  # local|dev|test|staging|pre-prod|prod|dr · req:all · sens:C
NODE_ENV=development                           # Must be production when APP_ENV=prod|dr · req:all · sens:C
APP_PRODUCT=LD                                 # Product code (IPB) · req:all · sens:C
APP_NAME=lawdocs-api                           # OTel service.name · req:all · sens:C
APP_VERSION=0.0.0-local                        # Set by CI from Changesets (`vYYYY.MM.N`) · req:all · sens:C
APP_GIT_SHA=local                              # Commit SHA from CI · req:all · sens:C
APP_PORT=4000                                  # API listen port · req:all · sens:C
APP_HOST=0.0.0.0                               # Bind address · req:all · sens:C
APP_BASE_URL=http://localhost:4000             # API base URL (prod: https://api.lawdocs.in) · req:all · sens:C
APP_PUBLIC_URL=http://localhost:3000           # apps/public (prod: https://www.lawdocs.in; canonical host — P21 FR-P21-04) · req:all · sens:C
APP_WEB_URL=http://localhost:3001              # apps/web (prod: https://my.lawdocs.in) · req:all · sens:C
APP_DELIVERY_URL=http://localhost:3003         # apps/delivery (prod: https://work.lawdocs.in) · req:all · sens:C
APP_CONSOLE_URL=http://localhost:3002          # apps/console (prod: https://admin.lawdocs.in) · req:all · sens:C
APP_DEVELOPER_PORTAL_URL=http://localhost:3004 # developers.lawdocs.in (P19 FR-P19-72) · req:opt · sens:C
APP_CONSUMER_HELP_PUBLIC_URL=                  # [Consumer Help Brand] site host; empty until D-06 brand decided · req:opt · sens:C
APP_TRUST_PROXY=1                              # Trusted proxy hops · req:all · sens:C
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003  # Comma list · req:all · sens:C
APP_DEFAULT_TZ=Asia/Kolkata                    # Schedules and display · req:all · sens:C
APP_DEFAULT_LOCALE=en-IN                       # Default locale (D-07 languages enabled per brand) · req:all · sens:C
APP_REGION=ap-south-1                          # Deployment region label (reference AWS Mumbai; DR ap-south-2) · req:all · sens:C
APP_REQUEST_BODY_LIMIT_MB=10                   # JSON/multipart body limit; files go by presigned URL (P19 FR-P19-01) · req:opt · sens:C

# ---------- DB_ (PostgreSQL only — IPB-D-02; Supabase DB-only in non-prod) ----------
DB_URL=postgres://app@localhost:5432/lawdocs   # Connection URL WITHOUT password · req:all · sens:C
DB_PASSWORD=app                                # Password (prod: secret://aws-sm/infrabyx/ld/prod/db#password) · req:all · sens:S
DB_SSL_MODE=disable                            # disable|require|verify-full; verify-full in staging/pre-prod/prod/dr · req:all · sens:C
DB_SSL_CA_REF=                                 # secret:// CA bundle for verify-full · req:prod · sens:S
DB_POOL_MAX=20                                 # Per instance · req:opt · sens:C
DB_MIGRATIONS_ROLE=app_migrator                # Expand→migrate→contract job role (P23 FR-P23-17) · req:all · sens:C
DB_MIGRATIONS_PASSWORD=migrator                # · req:all · sens:S
DB_RLS_BYPASS_ROLE=                            # MUST be empty in prod; break-glass only via SECRETS (NN-01) · req:opt · sens:S
DB_PGVECTOR_DIMS=1024                          # Embedding dimension (P09 retrieval) · req:all · sens:C
DB_CONSUMER_HELP_URL=                          # Separate cell for the Consumer Help brand (X-17); empty = same cluster, separate schema set · req:opt · sens:C

# ---------- CACHE_ / QUEUE_ (Redis, BullMQ) ----------
CACHE_REDIS_URL=redis://localhost:6379/0       # Cache and rate limits · req:all · sens:C
CACHE_REDIS_PASSWORD=                          # · req:prod · sens:S
CACHE_REDIS_TLS=false                          # true in prod · req:all · sens:C
QUEUE_REDIS_URL=redis://localhost:6379/1       # BullMQ short jobs · req:all · sens:C

# ---------- WORKFLOW_ (Temporal: signing ceremonies, negotiations, hearings, exports, agent missions) ----------
WORKFLOW_TEMPORAL_ADDRESS=localhost:7233       # · req:all · sens:C
WORKFLOW_TEMPORAL_NAMESPACE=ld-local           # Per product per env · req:all · sens:C
WORKFLOW_TEMPORAL_TLS_CERT_REF=                # secret:// · req:prod · sens:S
WORKFLOW_TEMPORAL_TLS_KEY_REF=                 # secret:// · req:prod · sens:S
WORKFLOW_TASK_QUEUE=ld-main                    # · req:all · sens:C

# ---------- AUTH_ (IDENTITY port; Keycloak reference; realms `ld` and `ld-staff`) ----------
AUTH_ADAPTER=keycloak                          # keycloak|zitadel|entra · req:all · sens:C
AUTH_ISSUER_URL=http://localhost:8080/realms/ld  # Customer realm issuer; https in prod · req:all · sens:C
AUTH_STAFF_ISSUER_URL=http://localhost:8080/realms/ld-staff  # Staff realm (federated to group Entra ID) · req:all · sens:C
AUTH_CLIENT_ID=ld-api                          # · req:all · sens:C
AUTH_CLIENT_SECRET=dev-secret                  # Literal refused in prod · req:all · sens:S
AUTH_ADMIN_CLIENT_ID=ld-admin                  # Keycloak admin API (seeds, SCIM) · req:nonprod · sens:C
AUTH_ADMIN_CLIENT_SECRET=dev-admin-secret      # · req:nonprod · sens:S
AUTH_SESSION_COOKIE_NAME=__Host-ld_sess        # · req:all · sens:C
AUTH_SESSION_SECRET=change-me-32-bytes-minimum # ≥32 bytes · req:all · sens:S
AUTH_SESSION_TTL_MIN=480                       # Idle TTL ceiling; tenant policy may lower (sec.org.session.idle_minutes) · req:opt · sens:C
AUTH_MFA_REQUIRED_ROLES=PLT_SUPER_ADMIN,PLT_SECURITY_OFFICER,PLT_SRE,PLT_RELEASE_MANAGER,PLT_DPO,ORG_OWNER,ORG_ADMIN,OPS_RM  # Forced MFA (NN; P01) · req:all · sens:C
AUTH_PASSKEYS_RP_ID=localhost                  # WebAuthn RP ID (prod: lawdocs.in) · req:all · sens:C
AUTH_PASSKEYS_ORIGINS=http://localhost:3001,http://localhost:3003,http://localhost:3002  # Related origins · req:all · sens:C
AUTH_SCIM_BEARER_REF=                          # secret:// inbound SCIM token (company tenants) · req:opt · sens:S
AUTH_SUPER_ADMIN_EMAIL=rjnprajapati@gmail.com  # Bootstrap super admin (IPB-D-04) · req:all · sens:C
AUTH_BREAK_GLASS_ENABLED=false                 # Must be false in prod · req:opt · sens:C

# ---------- AUTHZ_ / RULES_ (Cerbos; GoRules ZEN + CEL behind RULES_PORT) ----------
AUTHZ_CERBOS_URL=http://localhost:3592         # · req:all · sens:C
RULES_ADAPTER=gorules                          # gorules|cel · req:all · sens:C
RULES_GORULES_URL=http://localhost:3593        # · req:all · sens:C

# ---------- STORAGE_ (STORAGE port; S3 + Object Lock reference; MinIO local; Azure Blob / GCS alternatives) ----------
STORAGE_ADAPTER=s3                             # s3|minio|azure_blob|gcs · req:all · sens:C
STORAGE_ENDPOINT=http://localhost:9000         # MinIO local; empty for AWS · req:nonprod · sens:C
STORAGE_REGION=ap-south-1                      # · req:all · sens:C
STORAGE_BUCKET_DOCS=ld-docs-local              # Vault originals, signed files, evidence (Object Lock in prod — NN-09) · req:all · sens:C
STORAGE_BUCKET_PUBLIC=ld-public-local          # CMS media, resources files, OG images · req:all · sens:C
STORAGE_BUCKET_EXPORTS=ld-exports-local        # LD-EXPORT-1.0 archives · req:all · sens:C
STORAGE_BUCKET_LOGS=ld-logs-local              # 180-day CERT-In logs (WORM) · req:all · sens:C
STORAGE_BUCKET_CONTENT=ld-content-local        # Platform content plane: templates, clauses, DOCX import originals (never tenant data) · req:all · sens:C
STORAGE_BUCKET_CONSUMER_HELP=                  # Separate bucket for the Consumer Help cell (X-17) · req:opt · sens:C
STORAGE_ACCESS_KEY_ID=minioadmin               # Prod uses IAM role — leave empty · req:nonprod · sens:S
STORAGE_SECRET_ACCESS_KEY=minioadmin           # · req:nonprod · sens:S
STORAGE_OBJECT_LOCK_MODE=GOVERNANCE            # COMPLIANCE in prod for docs/evidence (xpt.storage.object_lock_mode) · req:prod · sens:C
STORAGE_KMS_KEY_REF=                           # KMS key ARN/ref for SSE-KMS; per-tenant data keys wrap under it · req:prod · sens:S
STORAGE_AV_SCAN_URL=http://localhost:3310      # ClamAV/ICAP (AV port) for every upload incl. CMS, blog, resources · req:all · sens:C
STORAGE_BYO_ALLOWED_ADAPTERS=s3,azure_blob,gcs,sharepoint,gdrive,sftp  # Tenant BYO storage targets (P20 §4G) · req:opt · sens:C

# ---------- SEARCH_ (SEARCH port; PostgreSQL FTS first, OpenSearch at the volume gate) ----------
SEARCH_ADAPTER=pg_fts                          # pg_fts|opensearch · req:all · sens:C
SEARCH_OPENSEARCH_URL=                         # · req:opt · sens:C

# ---------- DOCGEN_ / PDF_ (docxtemplater, @infrabyx/docgen, @infrabyx/redline, Gotenberg) ----------
DOCGEN_GOTENBERG_URL=http://localhost:3010     # PDF, PDF/A-2b/3b conversion · req:all · sens:C
DOCGEN_PDFA_ENABLED=true                       # · req:opt · sens:C
PDF_SIGNING_KMS_KEY_REF=                       # PAdES signing key for evidence packs/platform seals (KMS) · req:prod · sens:S

# ---------- SECRETS_ / KMS_ ----------
SECRETS_ADAPTER=env                            # env (local only)|aws_sm|azure_kv|gcp_sm|vault · req:all · sens:C
SECRETS_AWS_REGION=ap-south-1                  # · req:prod · sens:C
KMS_ADAPTER=aws_kms                            # aws_kms|azure_kv|gcp_kms|vault_transit (envelope encryption, per-tenant data keys) · req:all · sens:C
KMS_ROOT_KEY_REF=                              # Root key for tenant data-key wrapping · req:prod · sens:S

# ---------- AI_ (packages/ai + packages/vidhi; IPB-03; D-14 Claude reference) ----------
AI_ENABLED=true                                # · req:all · sens:C
AI_DEFAULT_BAND_OPEN_ADAPTER=anthropic_direct  # PUBLIC/INTERNAL band · req:all · sens:C
AI_DEFAULT_BAND_IN_ZERO_ADAPTER=bedrock_claude_in  # PERSONAL/CONFIDENTIAL/SENSITIVE band (India, zero retention) · req:all · sens:C
AI_DEFAULT_BAND_SELF_ADAPTER=self_hosted_vllm  # Self-hosted band (SECRET never sent; sovereign option) · req:opt · sens:C
AI_ANTHROPIC_API_KEY=                          # anthropic_direct (public content only) · req:opt · sens:S
AI_BEDROCK_REGION=ap-south-1                   # Must be ap-south-1 · req:all · sens:C
AI_BEDROCK_ROLE_ARN=                           # Prod uses task role · req:opt · sens:C
AI_AZURE_OPENAI_ENDPOINT=                      # azure_openai_in (Central India) · req:opt · sens:C
AI_AZURE_OPENAI_REGION=centralindia            # Must be centralindia · req:opt · sens:C
AI_AZURE_OPENAI_API_KEY=                       # · req:opt · sens:S
AI_VERTEX_PROJECT_ID=                          # vertex_gemini_in / Imagen · req:opt · sens:C
AI_VERTEX_REGION=asia-south1                   # Must be asia-south1 · req:opt · sens:C
AI_VERTEX_SA_KEY_REF=                          # secret:// · req:opt · sens:S
AI_XAI_API_KEY=                                # xai_grok (PUBLIC only; OFF until evals pass) · req:opt · sens:S
AI_SARVAM_API_KEY=                             # sarvam (Indic text/speech) · req:opt · sens:S
AI_BHASHINI_USER_ID=                           # Bhashini/ULCA · req:opt · sens:C
AI_BHASHINI_API_KEY=                           # · req:opt · sens:S
AI_VLLM_BASE_URL=http://localhost:8000/v1      # self_hosted_vllm · req:opt · sens:C
AI_IMAGE_DEFAULT_ADAPTER=                      # IMAGE_GEN port: bedrock_image|vertex_imagen|openai_image; EMPTY = feature hidden (02 §4 row 23) · req:opt · sens:C
AI_C2PA_SIGNING_KEY_REF=                       # secret:// key for AI-image provenance manifests · req:opt · sens:S
AI_SPEECH_DEFAULT_STT=bhashini                 # SPEECH port STT (Indic) · req:opt · sens:C
AI_SPEECH_DEFAULT_TTS=bhashini                 # SPEECH port TTS · req:opt · sens:C
AI_TRANSLATE_ADAPTER=bhashini                  # TRANSLATE port: bhashini|google|azure (P05; labelled MT — NN-48) · req:opt · sens:C
AI_OCR_ENGINE=tesseract                        # OCR port deterministic engine: tesseract|paddleocr (P05) · req:all · sens:C
AI_RERANK_ADAPTER=                             # self_hosted_bge|cohere|empty · req:opt · sens:C
AI_EVAL_JUDGE_ADAPTER=bedrock_claude_in        # Never the model under test · req:nonprod · sens:C
AI_OBS_CAPTURE_CONTENT=false                   # Never true in prod · req:all · sens:C
AI_MCP_SERVER_PATH=/mcp                        # Vidhi MCP server path (tenant toggle ai.mcp.server_enabled) · req:opt · sens:C

# ---------- LD_ (product ports: eSign, eStamp, KYC, company data, court and TM data) ----------
LD_ESIGN_ADAPTER=self                          # ESIGN port: self (mock signer, local only)|leegality|digio|melento|surepass [VERIFY vendor APIs; D-12] · req:all · sens:C
LD_ESIGN_API_KEY_REF=                          # secret:// aggregator credentials · req:opt · sens:S
LD_ESIGN_CALLBACK_URL=http://localhost:4000/hooks/esign  # Vendor callback (prod: https://hooks.lawdocs.in/esign) · req:all · sens:C
LD_ESIGN_SECOND_ESP_ADAPTER=                   # Second ESP route (eSign API spec two-ESP rule [VERIFY]) · req:opt · sens:C
LD_ESP_LICENCE_WATCH=true                      # Block ESPs with lapsed/expiring CCA licences without renewal evidence (D-12B) · req:all · sens:C
LD_STAMP_ADAPTER=manual                        # ESTAMP port: manual (attach + UIN check)|shcil|state_portal|aggregator [VERIFY per State] · req:all · sens:C
LD_STAMP_API_KEY_REF=                          # secret:// · req:opt · sens:S
LD_KYC_ADAPTER=mock                            # KYC port: mock (local)|licensed vendor id (CH-04 lawful upstream) · req:all · sens:C
LD_KYC_API_KEY_REF=                            # secret:// · req:opt · sens:S
LD_DIGILOCKER_CLIENT_ID=                       # DigiLocker requester client (sandbox in non-prod) · req:opt · sens:C
LD_DIGILOCKER_CLIENT_SECRET_REF=               # secret:// · req:opt · sens:S
LD_OVSE_ENABLED=false                          # Aadhaar offline verification (OVSE) — OFF until registration verified · req:all · sens:C
LD_COMPANY_DATA_ADAPTER=mock                   # COMPANY_DATA port: mock|probe42|signzy|surepass|karza (licensed MCA data) · req:all · sens:C
LD_COMPANY_DATA_API_KEY_REF=                   # secret:// · req:opt · sens:S
LD_COURT_DATA_ADAPTER_PRIMARY=manual           # COURT_DATA port: manual (CNR + refresh)|licensed aggregator id (never scraping — NN-05) · req:all · sens:C
LD_COURT_DATA_ADAPTER_SECONDARY=               # Second licensed aggregator · req:opt · sens:C
LD_COURT_DATA_API_KEY_REF=                     # secret:// · req:opt · sens:S
LD_TRADEMARK_DATA_ADAPTER=manual               # TRADEMARK_DATA port: manual|wipo_gbd|licensed partner [VERIFY] · req:all · sens:C
LD_TEMPLATE_LIBRARY_BUCKET=ld-content-local    # Published templates/clauses (content plane) · req:all · sens:C
LD_REDLINE_ENGINE_URL=http://localhost:3020    # @infrabyx/redline service (OOXML track changes — NN-37) · req:all · sens:C
LD_EXPORT_PROFILE_DEFAULT=ld_company_v1        # LD-EXPORT-1.0 default profile (Appendix K) · req:all · sens:C
LD_CONSUMER_HELP_ENABLED=false                 # [Consumer Help Brand] site and cell (D-06; web.brand.consumer_help.enabled) · req:all · sens:C
LD_ACADEMY_FEED_URL=                           # FinLegal Academy (Graphy) catalogue feed (D-16) · req:opt · sens:C

# ---------- CALENDAR_ / WORKSPACE_ (CALENDAR and WORKSPACE ports; P19 FR-P19-85) ----------
CALENDAR_ADAPTERS_ENABLED=internal             # internal(always)|google|microsoft|caldav — comma list · req:all · sens:C
CALENDAR_GOOGLE_CLIENT_ID=                     # · req:opt · sens:C
CALENDAR_MS_GRAPH_CLIENT_ID=                   # · req:opt · sens:C
WORKSPACE_ADAPTER=none                         # none|ms_graph|google_workspace (customer-owned files; narrow scopes) · req:all · sens:C
WORKSPACE_CLIENT_SECRET_REF=                   # secret:// · req:opt · sens:S

# ---------- PAYMENTS_ / BILLING (BILLING port → Operations Hub OH8; Razorpay reference; hosted checkout only — NN-22) ----------
PAYMENTS_ADAPTER=razorpay                      # razorpay|payu|cashfree (switched in OH8, mirrored here) · req:all · sens:C
PAYMENTS_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx     # Test prefix refused in prod · req:opt · sens:C
PAYMENTS_RAZORPAY_KEY_SECRET=                  # · req:opt · sens:S
PAYMENTS_RAZORPAY_WEBHOOK_SECRET=              # Webhook signature verification · req:opt · sens:S
PAYMENTS_HOSTED_CHECKOUT_ONLY=true             # Must be true (PCI DSS SAQ A) · req:all · sens:C
PAYMENTS_BILLING_ENGINE_URL=http://localhost:4100  # OH8 endpoint (BILLING_PORT) · req:all · sens:C
PAYMENTS_BILLING_ENGINE_TOKEN_REF=             # secret:// service token · req:all · sens:S

# ---------- MSG_ (NOTIFY port: email, SMS, WhatsApp, RCS, voice, push; DLT-registered CPaaS — Appendix J) ----------
MSG_EMAIL_ADAPTER=smtp                         # smtp (MailHog local)|ses|brevo · req:all · sens:C
MSG_SMTP_HOST=localhost                        # · req:nonprod · sens:C
MSG_SMTP_PORT=1025                             # · req:nonprod · sens:C
MSG_EMAIL_FROM=no-reply@localhost              # Brand sender in prod (DMARC required — brand.email.require_dmarc) · req:all · sens:C
MSG_EMAIL_DKIM_KEY_REF=                        # secret:// · req:prod · sens:S
MSG_SMS_ADAPTER=none                           # none|jiocx|kaleyra|msg91 (DLT) · req:all · sens:C
MSG_SMS_API_KEY_REF=                           # secret:// · req:opt · sens:S
MSG_SMS_DLT_ENTITY_ID=                         # TRAI DLT entity id (ntf.dlt.require_template_id locked) · req:opt · sens:C
MSG_WHATSAPP_ADAPTER=none                      # none|meta_cloud|bsp (super-admin toggle; template registry in OH) · req:all · sens:C
MSG_WHATSAPP_PHONE_NUMBER_ID=                  # · req:opt · sens:C
MSG_WHATSAPP_ACCESS_TOKEN_REF=                 # secret:// · req:opt · sens:S
MSG_WHATSAPP_VERIFY_TOKEN_REF=                 # secret:// webhook verify token · req:opt · sens:S
MSG_VOICE_ADAPTER=none                         # none|exotel|kaleyra (AI-voice disclosure — NN-34) · req:opt · sens:C
MSG_PUSH_FCM_SA_KEY_REF=                       # secret:// FCM service account (P22); APNs key ref added when iOS push is enabled · req:opt · sens:S
MSG_WEBHOOK_SIGNING_SECRET_REF=                # secret:// Standard Webhooks signing key (outbound tenant webhooks) · req:all · sens:S

# ---------- WEB_ / MKT_ / FB_ (apps/public, CMS, consent, marketing, feedback — IPB-04) ----------
WEB_CANONICAL_HOST=http://localhost:3000       # web.host.canonical (prod: https://www.lawdocs.in) · req:all · sens:C
WEB_BRAND_HOST_MAP=localhost:3000=lawdocs      # host=brand_pack key pairs; unknown host → default pack noindex · req:all · sens:C
WEB_PREVIEW_SIGNING_KEY_REF=                   # secret:// signed preview URLs (24 h) · req:all · sens:S
WEB_REVALIDATE_TOKEN_REF=                      # secret:// on-publish revalidation token · req:all · sens:S
WEB_PLAGIARISM_ADAPTER=none                    # PLAGIARISM port: none|internal|copyscape · req:opt · sens:C
WEB_PLAGIARISM_API_KEY_REF=                    # secret:// · req:opt · sens:S
WEB_EGRESS_PROXY_URL=http://localhost:3128     # EGRESS port allow-listed outbound proxy (embeds, webhooks, link previews — SSRF guard) · req:all · sens:C
WEB_LAW_REGISTER_URL=                          # LAW_REGISTER port (LDC rules register read-only); empty = local snapshot · req:opt · sens:C
MKT_TAG_MANAGER_ADAPTER=none                   # none|gtm_server|gtm_web (02 §4 row 24; consent-gated; public marketing routes only) · req:all · sens:C
MKT_GTM_CONTAINER_ID=                          # · req:opt · sens:C
MKT_GTM_SERVER_URL=                            # Self-hosted server-side container URL · req:opt · sens:C
MKT_ANALYTICS_ADAPTER=matomo                   # matomo|posthog|plausible|none (self-hosted, India) · req:all · sens:C
MKT_ANALYTICS_SITE_ID=                         # · req:opt · sens:P
FB_SUPPORT_ADAPTER=internal                    # SUPPORT port: internal|ops_hub (OH6) for feedback bugs · req:all · sens:C
FB_BACKLOG_ADAPTER=internal                    # BACKLOG port: internal|ops_hub|github_issues · req:all · sens:C

# ---------- OBS_ (OpenTelemetry, errors, logs, audit chain) ----------
OBS_OTLP_ENDPOINT=http://localhost:4318        # · req:all · sens:C
OBS_OTLP_INSECURE=true                         # In-cluster only · req:opt · sens:C
OBS_SERVICE_NAMESPACE=infrabyx                 # · req:all · sens:C
OBS_TRACE_SAMPLE_RATIO=1.0                     # 0.1 in prod · req:all · sens:C
OBS_LOG_LEVEL=debug                            # info in prod · req:all · sens:C
OBS_LOG_FORMAT=pretty                          # json in prod · req:all · sens:C
OBS_ERRORS_DSN=                                # Sentry-compatible (self-hosted, India) · req:opt · sens:S
OBS_LOG_RETENTION_DAYS=180                     # CERT-In minimum (NN-27) · req:all · sens:C
OBS_AUDIT_HASH_CHAIN_KEY_REF=                  # secret:// HMAC key for the audit ledger chain (NN-02) · req:all · sens:S

# ---------- FLAGS_ (FEATURE_FLAG port; OpenFeature; rings and beta — P03 FR-P03-110, P23) ----------
FLAGS_ADAPTER=file                             # file|unleash|flagsmith · req:all · sens:C
FLAGS_FILE_PATH=./config/flags.local.json      # · req:nonprod · sens:C

# ---------- IPB_ (shared cross-product; Ecosystem Spec v1.2; Operations Hub) ----------
IPB_ECOSYSTEM_BUS_URL=nats://localhost:4222    # Cross-product CloudEvents bus (int module only — NN-24) · req:all · sens:C
IPB_ECOSYSTEM_BUS_CREDS_REF=                   # secret:// · req:prod · sens:S
IPB_ECOSYSTEM_V12_CONTRACTS_ENABLED=false      # int.eco.v12_contracts.enabled — ON only after tagged Spec v1.2 is committed (OI-P19-13) · req:all · sens:C
IPB_OPS_HUB_URL=http://localhost:4100          # OH API (CRM, support, backlog, HR, trust, billing) · req:all · sens:C
IPB_OPS_HUB_TOKEN_REF=                         # secret:// · req:all · sens:S
IPB_OPS_HUB_PRODUCT_SCOPE=LD                   # Sent on every OH call (IPB-D-12) · req:all · sens:C
IPB_BRAND_PACK_SOURCE=db                       # db|ops_hub · req:all · sens:C
IPB_TRUST_CENTRE_FEED_URL=                     # Vendor Assurance Room publish feed (TRUST port) · req:opt · sens:C
IPB_DATA_RESIDENCY=IN                          # Declared residency (NN-25) · req:all · sens:C
IPB_CERTIN_REPORT_EMAIL=                       # Incident reporting mailbox (runbook) · req:prod · sens:C

# ---------- SEED_ (non-production only; production refuses — IPB-D-04; synthetic data only — OP-7) ----------
SEED_ENABLED=true                              # Must be false/unset in prod/dr (boot fails otherwise) · req:nonprod · sens:C
SEED_PROFILE=dev                               # minimal|dev|demo|test|load; MUST be unset in prod/dr · req:nonprod · sens:C
SEED_RANDOM_SEED=20261026                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./env/SEED_CREDENTIALS.md  # Gitignored output · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/ld/local/seed  # · req:nonprod · sens:C
SEED_SANDBOX_RESET_CRON=0 2 * * *              # Nightly sandbox reset (demo/staging) · req:opt · sens:C

# ---------- Browser-exposed (apps/web, apps/public, apps/delivery, apps/console) ----------
NEXT_PUBLIC_APP_ENV=local                      # · req:all · sens:P
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000 # · req:all · sens:P
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/ld  # · req:all · sens:P
NEXT_PUBLIC_AUTH_CLIENT_ID=ld-web              # Public client · req:all · sens:P
NEXT_PUBLIC_PRODUCT=LD                         # · req:all · sens:P
NEXT_PUBLIC_CMP_ENABLED=true                   # Cookie consent manager · req:all · sens:P
NEXT_PUBLIC_ANALYTICS_SITE_ID=                 # Consent-gated; never on authenticated routes · req:opt · sens:P
NEXT_PUBLIC_VIDHI_DISPLAY_NAME=Vidhi           # vidhi.brand.display_name (brand pack; override only on white-label plans) · req:all · sens:P

# ---------- Mobile (Expo; apps/mobile — P22; brand flavours LawDocs and Consumer Help) ----------
EXPO_PUBLIC_APP_ENV=local                      # · req:all · sens:P
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000  # Android emulator host · req:all · sens:P
EXPO_PUBLIC_AUTH_ISSUER_URL=http://10.0.2.2:8080/realms/ld  # · req:all · sens:P
EXPO_PUBLIC_AUTH_CLIENT_ID=ld-mobile           # · req:all · sens:P
EXPO_PUBLIC_PRODUCT=LD                         # · req:all · sens:P
EXPO_PUBLIC_BRAND_FLAVOUR=lawdocs              # lawdocs|consumer_help · req:all · sens:P
