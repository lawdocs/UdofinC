############################################################
# Infrabyx UDOFIN (UDF) — environment template · IPB-11 v1.0 · Udofin Master Prompt v1.3 (26 Oct 2026)
# Generated shape: pnpm env:example. Edit the generator (packages/config/env.schema.ts), not this file by hand.
# Column key per comment: description · req: environments where required (all|nonprod|prod|opt) · sens: S secret / C config / P public.
# RULES: (1) every sens:S value MUST be a secret:// reference in staging, demo, prod and dr — literals are refused at boot;
# (2) SEED_* MUST be unset or false in prod/dr — boot refuses otherwise; (3) only EXPO_PUBLIC_* and NEXT_PUBLIC_* reach a client bundle;
# (4) no real borrower, KYC, bureau or loan data in any non-India environment (CF para 14(4)); (5) placeholders only in this file.
############################################################

# ---------- APP_ (process identity, URLs) ----------
APP_ENV=local                                  # local|dev|test|staging|demo|prod|dr · req:all · sens:C
NODE_ENV=development                           # production when APP_ENV=prod|dr · req:all · sens:C
APP_PRODUCT=UDF                                # Product code (fixed) · req:all · sens:C
APP_NAME=udofin-api                            # OTel service.name · req:all · sens:C
APP_VERSION=0.0.0-local                        # Set by CI from Changesets · req:all · sens:C
APP_PORT=4000                                  # HTTP listen port · req:all · sens:C
APP_HOST=0.0.0.0                               # Bind address · req:all · sens:C
APP_BASE_URL=http://localhost:4000             # API base URL; https in prod · req:all · sens:C
APP_PUBLIC_URL=http://localhost:3000           # Public website (apps/public) · req:all · sens:C
APP_WEB_URL=http://localhost:3001              # Borrower web app (apps/borrower-web) · req:all · sens:C
APP_PORTAL_URL=http://localhost:3002           # Portal app (ops, lender, admin workspaces) · req:all · sens:C
APP_CONSOLE_URL=http://localhost:3003          # Super-admin Studio / console · req:all · sens:C
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003  # Comma list · req:all · sens:C
APP_DEFAULT_TZ=Asia/Kolkata                    # Schedules and display · req:all · sens:C
APP_DEFAULT_LOCALE=en-IN                       # Default locale (borrower app offers 12) · req:all · sens:C
APP_REGION=ap-south-1                          # ap-south-1 | ap-south-2 · req:all · sens:C

# ---------- DB_ (PostgreSQL only; IPB-D-02) ----------
DB_URL=postgres://app@localhost:5432/udofin    # Main database, URL WITHOUT password · req:all · sens:C
DB_PASSWORD=app                                # prod: secret://aws-sm/infrabyx/udf/prod/db#password · req:all · sens:S
DB_SSL_MODE=disable                            # verify-full in staging/prod/dr · req:all · sens:C
DB_SSL_CA_REF=                                 # secret:// CA bundle when verify-full · req:prod · sens:S
DB_MIGRATIONS_ROLE=app_migrator                # expand→migrate→contract role · req:all · sens:C
DB_MIGRATIONS_PASSWORD=migrator                # · req:all · sens:S
DB_RLS_BYPASS_ROLE=                            # MUST be empty in prod · req:opt · sens:S
UDF_WELLNESS_DB_URL=postgres://app@localhost:5432/udofin_wellness  # Separate wellness store (Part 7D FW4); same engine · req:opt · sens:C

# ---------- CACHE_ / QUEUE_ ----------
CACHE_REDIS_URL=redis://localhost:6379/0       # · req:all · sens:C
CACHE_REDIS_PASSWORD=                          # · req:prod · sens:S
QUEUE_REDIS_URL=redis://localhost:6379/1       # BullMQ · req:all · sens:C

# ---------- WORKFLOW_ (Temporal; application, KYC, signing, mandate, grievance, white-label provisioning sagas) ----------
WORKFLOW_TEMPORAL_ADDRESS=localhost:7233       # · req:all · sens:C
WORKFLOW_TEMPORAL_NAMESPACE=udf-local          # Per product per env · req:all · sens:C
WORKFLOW_TEMPORAL_TLS_CERT_REF=                # secret:// · req:prod · sens:S
WORKFLOW_TEMPORAL_TLS_KEY_REF=                 # secret:// · req:prod · sens:S
WORKFLOW_PAYLOAD_CODEC_KEY_REF=                # secret:// payload encryption so no PII sits in history · req:all · sens:S

# ---------- AUTH_ (IDENTITY port; Keycloak reference; borrower OTP + device binding flows) ----------
AUTH_ADAPTER=keycloak                          # keycloak|entra|cognito · req:all · sens:C
AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-udf  # https in prod · req:all · sens:C
AUTH_CLIENT_ID=udf-api                         # · req:all · sens:C
AUTH_CLIENT_SECRET=dev-secret                  # Literal refused in prod · req:all · sens:S
AUTH_ADMIN_CLIENT_ID=udf-admin                 # Seeds, SCIM · req:nonprod · sens:C
AUTH_ADMIN_CLIENT_SECRET=dev-admin-secret      # · req:nonprod · sens:S
AUTH_SESSION_COOKIE_NAME=__Host-udf_sess       # · req:all · sens:C
AUTH_SESSION_SECRET=change-me-32-bytes-minimum # ≥32 bytes · req:all · sens:S
AUTH_SESSION_TTL_MIN=10                        # Borrower web idle timeout floor 10 min (G.10.2) · req:all · sens:C
AUTH_MFA_REQUIRED_ROLES=PLT_SUPER_ADMIN,PLT_SECURITY_OFFICER,ORG_OWNER,ORG_ADMIN,RE_ADMIN,OPS_ADMIN  # All staff roles are MFA · req:all · sens:C
AUTH_PASSKEYS_RP_ID=localhost                  # WebAuthn RP ID · req:all · sens:C
AUTH_PASSKEYS_ORIGINS=http://localhost:3001    # Related origins (brand-pack hosts added at publish) · req:all · sens:C
AUTH_OTP_MAX_ATTEMPTS=5                        # Floor 5 attempts, 30-min lockout (G.10.2) · req:all · sens:C
AUTH_OTP_LOCKOUT_MIN=30                        # · req:all · sens:C
AUTH_SUPER_ADMIN_EMAIL=rjnprajapati@gmail.com  # Bootstrap super admin (IPB-D-04) · req:all · sens:C
AUTH_BREAK_GLASS_ENABLED=false                 # Must be false in prod · req:opt · sens:C

# ---------- AUTHZ_ / RULES_ ----------
AUTHZ_CERBOS_URL=http://localhost:3592         # Cerbos PDP · req:all · sens:C
RULES_ADAPTER=gorules                          # gorules|cel · req:all · sens:C
RULES_GORULES_URL=http://localhost:3593        # ZEN engine (RE pre-filters, routing, display rules) · req:all · sens:C
RULES_GORULES_API_KEY=                         # · req:opt · sens:S

# ---------- STORAGE_ (STORAGE port; RE-scoped vault with per-RE KMS keys) ----------
STORAGE_ADAPTER=s3                             # s3|minio|azure_blob|gcs · req:all · sens:C
STORAGE_ENDPOINT=http://localhost:9000         # MinIO locally; empty for AWS · req:nonprod · sens:C
STORAGE_REGION=ap-south-1                      # · req:all · sens:C
STORAGE_BUCKET_DOCS=udf-docs-local             # KFS, agreements, signed documents (Object Lock in prod) · req:all · sens:C
STORAGE_BUCKET_VAULT=udf-vault-local           # RE-scoped vault (KYC images, bureau, statements) · req:all · sens:C
STORAGE_BUCKET_PUBLIC=udf-public-local         # CMS media, brand assets · req:all · sens:C
STORAGE_BUCKET_EXPORTS=udf-exports-local       # Borrower exports (UB1), RE packs (UP3), archives (RA3) · req:all · sens:C
STORAGE_BUCKET_LOGS=udf-logs-local             # 180-day CERT-In logs (WORM) · req:all · sens:C
STORAGE_ACCESS_KEY_ID=minioadmin               # prod uses IAM role (leave empty) · req:nonprod · sens:S
STORAGE_SECRET_ACCESS_KEY=minioadmin           # · req:nonprod · sens:S
STORAGE_PRESIGN_TTL_S=900                      # Borrower document links: floor 15 min (G.10.2) · req:opt · sens:C
STORAGE_KMS_KEY_REF=                           # Platform KMS key; per-RE keys resolved from the RE record · req:prod · sens:S
STORAGE_AV_SCAN_URL=http://localhost:3310      # ClamAV/ICAP (every upload incl. CMS) · req:all · sens:C

# ---------- SEARCH_ ----------
SEARCH_ADAPTER=pg_fts                          # pg_fts|opensearch · req:all · sens:C

# ---------- DOCGEN_ ----------
DOCGEN_GOTENBERG_URL=http://localhost:3010     # KFS, certificates, packs · req:all · sens:C

# ---------- SECRETS_ ----------
SECRETS_ADAPTER=env                            # env (local only)|aws_sm|vault|azure_kv|gcp_sm · req:all · sens:C
SECRETS_AWS_REGION=ap-south-1                  # · req:prod · sens:C

# ---------- AI_ (packages/ai gateway + Vidhi kernel; IPB-03; data-class routing) ----------
AI_ENABLED=true                                # Master switch · req:all · sens:C
AI_DEFAULT_BAND_OPEN_ADAPTER=anthropic_direct  # PUBLIC/INTERNAL classes · req:all · sens:C
AI_DEFAULT_BAND_IN_ZERO_ADAPTER=bedrock_claude_in  # CONFIDENTIAL/REGULATED: India-resident zero retention (IPB-D-06; CF 14(4)) · req:all · sens:C
AI_ANTHROPIC_API_KEY=                          # · req:opt · sens:S
AI_BEDROCK_REGION=ap-south-1                   # Must be ap-south-1 · req:all · sens:C
AI_BEDROCK_ROLE_ARN=                           # · req:opt · sens:C
AI_BHASHINI_API_KEY=                           # STT/translate reference · req:opt · sens:S
AI_SPEECH_DEFAULT_STT=bhashini                 # SPEECH port STT · req:all · sens:C
AI_SPEECH_DEFAULT_TTS=azure_speech_in          # SPEECH port TTS (Central India) · req:all · sens:C
AI_AZURE_SPEECH_KEY=                           # · req:opt · sens:S
AI_TRANSLATE_ADAPTER=bhashini                  # TRANSLATE port (approved strings only for regulatory text) · req:all · sens:C
AI_C2PA_SIGNING_KEY_REF=                       # secret:// provenance manifests · req:opt · sens:S
AI_OBS_CAPTURE_CONTENT=false                   # Never true in prod · req:all · sens:C
AI_VIDHI_AUTONOMY_CEILING_BORROWER=L1          # Fixed by IPB-DEV-02; boot refuses higher · req:all · sens:C
AI_VIDHI_AUTONOMY_CEILING_OPS=L2               # Fixed by IPB-DEV-02 · req:all · sens:C
AI_MCP_SERVER_ENABLED=false                    # fut.mcp-server; per-tenant override in settings · req:all · sens:C
AI_KILL_SWITCH=false                           # Emergency off (also settable at runtime) · req:all · sens:C

# ---------- PAYMENTS_ (Udofin revenue ONLY — never loan money; RE gateways use RE credentials in the vault) ----------
PAYMENTS_ADAPTER=razorpay                      # razorpay|cashfree|payu · req:all · sens:C
PAYMENTS_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx     # Test prefix refused in prod · req:opt · sens:C
PAYMENTS_RAZORPAY_KEY_SECRET=                  # · req:opt · sens:S
PAYMENTS_HOSTED_CHECKOUT_ONLY=true             # PCI DSS SAQ A; must be true · req:all · sens:C
PAYMENTS_BILLING_ENGINE_URL=http://localhost:4100  # Operations Hub OH8 (RE invoicing, plan catalogue) · req:all · sens:C
PAYMENTS_BILLING_ENGINE_TOKEN_REF=             # secret:// · req:all · sens:S
UDF_NO_MONEY_FLOW_GUARD=true                   # Platform guard-rail: no Udofin account in any disbursement/repayment flow (CF para 10); cannot be false · req:all · sens:C

# ---------- MSG_ (NOTIFY port: email, SMS, WhatsApp, push) ----------
MSG_EMAIL_ADAPTER=smtp                         # smtp|ses · req:all · sens:C
MSG_SMTP_HOST=localhost                        # MailHog locally · req:nonprod · sens:C
MSG_SMTP_PORT=1025                             # · req:nonprod · sens:C
MSG_EMAIL_FROM=no-reply@localhost              # Brand-pack email identity overrides per host · req:all · sens:C
MSG_EMAIL_DKIM_KEY_REF=                        # secret:// · req:prod · sens:S
MSG_SMS_ADAPTER=none                           # none|msg91|kaleyra · req:all · sens:C
MSG_SMS_API_KEY=                               # · req:opt · sens:S
MSG_WHATSAPP_ENABLED=false                     # Super-admin toggle; utility templates only; never recovery (UR6-C12) · req:all · sens:C
MSG_WHATSAPP_ADAPTER=none                      # none|meta_cloud|bsp (App B item 12; IPB open item 4) · req:all · sens:C
MSG_WHATSAPP_PHONE_NUMBER_ID=                  # · req:opt · sens:C
MSG_WHATSAPP_ACCESS_TOKEN_REF=                 # secret:// · req:opt · sens:S
MSG_PUSH_FCM_SA_KEY_REF=                       # secret:// · req:opt · sens:S
MSG_PUSH_APNS_KEY_REF=                         # secret:// · req:opt · sens:S
MSG_WEBHOOK_SIGNING_SECRET_REF=                # secret:// Standard Webhooks (outbound to REs) · req:all · sens:S

# ---------- VOICE_ (RA5; Udofin outbound service voice stays OFF until 1600-series eligibility) ----------
VOICE_ADAPTER=mock                             # mock|exotel|jiocx · req:all · sens:C
VOICE_UDOFIN_OUTBOUND_ENABLED=false            # GATE Appendix B item 36 · req:all · sens:C

# ---------- OBS_ ----------
OBS_OTLP_ENDPOINT=http://localhost:4318        # · req:all · sens:C
OBS_SERVICE_NAMESPACE=infrabyx                 # · req:all · sens:C
OBS_TRACE_SAMPLE_RATIO=1.0                     # 0.1 in prod · req:all · sens:C
OBS_LOG_LEVEL=debug                            # info in prod · req:all · sens:C
OBS_ERRORS_DSN=                                # Self-hosted Sentry (PII scrubbed) · req:opt · sens:S
OBS_LOG_RETENTION_DAYS=180                     # CERT-In minimum · req:all · sens:C
OBS_AUDIT_HASH_CHAIN_KEY_REF=                  # secret:// HMAC for the hash-chained audit ledger · req:all · sens:S

# ---------- FLAGS_ (FEATURE_FLAG port; OpenFeature; mod./kill./fut. namespaces; per-RE overrides for mod. only) ----------
FLAGS_ADAPTER=file                             # file|unleash|flagsmith · req:all · sens:C
FLAGS_FILE_PATH=./config/flags.local.json      # · req:nonprod · sens:C

# ---------- IPB_ (cross-product; Ecosystem Spec v1.2) ----------
IPB_ECOSYSTEM_BUS_URL=nats://localhost:4222    # CloudEvents bus · req:all · sens:C
IPB_ECOSYSTEM_BUS_CREDS_REF=                   # secret:// · req:prod · sens:S
IPB_OPS_HUB_URL=http://localhost:4100          # OH API (billing mirror, vendor assurance, CRM, support, HR) · req:all · sens:C
IPB_OPS_HUB_TOKEN_REF=                         # secret:// · req:all · sens:S
IPB_BRAND_PACK_SOURCE=db                       # db|ops_hub · req:all · sens:C
IPB_TRUST_CENTRE_FEED_URL=                     # OH14.6 publish feed (TRUST port) · req:opt · sens:C
IPB_LAW_REGISTER_URL=                          # LawDocsComply register (read-only) for "i" references; snapshot fallback · req:opt · sens:C
IPB_DATA_RESIDENCY=IN                          # Declared residency · req:all · sens:C
IPB_CERTIN_REPORT_EMAIL=                       # Incident mailbox (6-hour CERT-In) · req:prod · sens:C

# ---------- UDF_ (product-specific) ----------
UDF_LSP_ID=                                    # Udofin's LSP identifier used in CIMS extracts and agreements · req:all · sens:C
UDF_KFS_SIGNING_KEY_REF=                       # secret:// KFS integrity signing key (self-signed in nonprod; fut.kfs-digital-sign) · req:all · sens:S
UDF_GRIEVANCE_OFFICER_CONTACT_SOURCE=brand_pack  # Nodal/GRO contacts resolved from brand_pack and RE record · req:all · sens:C
UDF_COOLING_OFF_DEFAULT_DAYS=3                 # Display default; floor 1 day; RE sets per product (CF para 11) · req:all · sens:C
UDF_OFFER_MATCH_LOG_BUCKET=udf-offer-logs-local  # Offer-set, ranking and unmatched-lender logs (CF para 7) · req:all · sens:C
UDF_RANKING_METRIC=APR_ASC_THEN_EMI            # Fixed until published on the website first (G.10.2) · req:all · sens:C
UDF_APP_STORE_ID=                              # Apple App Store id (default Udofin app) · req:opt · sens:C
UDF_PLAY_STORE_ID=                             # Google Play package (default Udofin app) · req:opt · sens:C
UDF_DEEPLINK_SCHEME=udofin                     # App deep-link scheme; brand packs register their own · req:all · sens:C
UDF_BRAND_PACKS_ENABLED=false                  # GATE Appendix B item 48 · req:all · sens:C
UDF_MULTI_RE_PACK_ALLOWED=false                # GATE legal opinion (IB3.1) · req:all · sens:C
UDF_ADDONS_WELLNESS=false                      # GATE FW4 G1–G5 · req:all · sens:C
UDF_ADVERTISING_S10=false                      # GATE Appendix B item 29 · req:all · sens:C

# ---------- UDF_MKT_ / UDF_CMS_ (public site only; hard-disabled on authenticated and mobile routes — IPB-DEV-03; product prefix per IPB-11-05, v1.3 review) ----------
UDF_MKT_PIXELS_ENABLED=false                   # Consent-gated on apps/public only · req:all · sens:C
UDF_MKT_TAG_MANAGER_ADAPTER=none               # none|gtm_web|server_side (App B item 52) · req:all · sens:C
UDF_MKT_ANALYTICS_ADAPTER=none                 # none|plausible_self|matomo · req:all · sens:C
UDF_CMS_CLAIMS_BLOCK_UNEVIDENCED=true          # Claims Register blocking rule; cannot be false · req:all · sens:C
UDF_CMS_EDUCATOR_POSTS_ENABLED=false           # GATE Appendix B item 46 · req:all · sens:C
UDF_CMS_INVESTORS_PAGE_ENABLED=false           # GATE Appendix B item 47 · req:all · sens:C
UDF_CMS_EGRESS_ALLOWLIST=youtube-nocookie.com,player.vimeo.com  # Embed provider allow-list (Phase 22 FR-22-35); fetches via EGRESS port · req:all · sens:C

# ---------- SEED_ (non-production only; boot refuses in prod/dr) ----------
SEED_ENABLED=true                              # MUST be false/unset in prod/dr · req:nonprod · sens:C
SEED_PROFILE=dev                               # dev|demo|test|load · req:nonprod · sens:C
SEED_RANDOM_SEED=20261026                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./SEED_CREDENTIALS.md    # Gitignored output · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/udf/local/seed  # · req:nonprod · sens:C

# ---------- Browser-exposed (apps/public, apps/borrower-web, apps/portal, apps/console) ----------
NEXT_PUBLIC_APP_ENV=local                      # · req:all · sens:P
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000 # · req:all · sens:P
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-udf  # · req:all · sens:P
NEXT_PUBLIC_AUTH_CLIENT_ID=udf-web             # · req:all · sens:P
NEXT_PUBLIC_PRODUCT=UDF                        # · req:all · sens:P
NEXT_PUBLIC_CMP_ENABLED=true                   # Cookie consent manager (public site) · req:all · sens:P
NEXT_PUBLIC_ANALYTICS_ID=                      # Consent-gated; never read on authenticated routes · req:opt · sens:P

# ---------- Mobile (Expo SDK 57; borrower app and field app) — only EXPO_PUBLIC_* reach the bundle ----------
EXPO_PUBLIC_APP_ENV=local                      # · req:all · sens:P
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000  # Android emulator host · req:all · sens:P
EXPO_PUBLIC_AUTH_ISSUER_URL=http://10.0.2.2:8080/realms/infrabyx-udf  # · req:all · sens:P
EXPO_PUBLIC_AUTH_CLIENT_ID=udofin-mobile       # · req:all · sens:P
EXPO_PUBLIC_PRODUCT=UDF                        # · req:all · sens:P
EXPO_PUBLIC_BRAND_PACK_ID=default              # Injected per EAS channel for white-label builds (Phase 23); never a secret · req:all · sens:P
