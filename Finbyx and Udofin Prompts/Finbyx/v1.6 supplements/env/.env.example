############################################################
# Infrabyx FINBYX (FBX) — environment template
# Derived from IPB-11 v1.0 §11.4.3 (generated form: pnpm env:example; this hand-derived copy is
# the v1.6 reference until Phase 1 produces the generated file, which must match it).
# Columns in each comment: description · req: environments where required (all | nonprod | prod | opt)
# · sens: S (secret — MUST be a secret:// reference in staging/demo/prod/dr) | C (config) | P (public).
# Values are LOCAL defaults or placeholders. Never commit real values. Production refuses .env secrets,
# seed profiles and Supabase hosts at boot (IPB-ENV-001, IPB-ENV-002).
# Finbyx v1.6 · 26 October 2026 · 163 variables; port-specific optional keys omitted here are listed in IPB-11 §11.4.3 and added by `pnpm env:example` as req:opt
############################################################

# ---------- APP_ (process identity, URLs) ----------
APP_ENV=local                                  # local|dev|test|preview|staging|pre-prod|prod|dr · req:all · sens:C
NODE_ENV=development                           # production when APP_ENV=prod|dr · req:all · sens:C
APP_PRODUCT=FBX                                # Product code (fixed) · req:all · sens:C
APP_NAME=finbyx-api                            # Process name; OTel service.name · req:all · sens:C
APP_VERSION=0.0.0-local                        # Set by CI from Changesets; shown in /health and Settings › About · req:all · sens:C
APP_GIT_SHA=local                              # Commit SHA from CI · req:all · sens:C
APP_PORT=4000                                  # HTTP listen port (TCP port, not a capability port) · req:all · sens:C
APP_BASE_URL=http://localhost:4000             # API base URL; https in prod · req:all · sens:C
APP_PUBLIC_URL=http://localhost:3000           # Public website (apps/public; Phase 21) · req:all · sens:C
APP_WEB_URL=http://localhost:3001              # Tenant app (apps/web) · req:all · sens:C
APP_CONSOLE_URL=http://localhost:3002          # Super-admin Studio (apps/console) · req:all · sens:C
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003  # Comma list · req:all · sens:C
APP_DEFAULT_TZ=Asia/Kolkata                    # IST for business dates, COB, contact windows (G.1.3) · req:all · sens:C
APP_DEFAULT_LOCALE=en-IN                       # Default locale; hi-IN available · req:all · sens:C
APP_REGION=ap-south-1                          # Deployment region label; ap-south-2 for DR · req:all · sens:C
APP_MAINTENANCE_MODE=false                     # 503 except health; never during COB · req:opt · sens:C

# ---------- DB_ (PostgreSQL only; IPB-D-02) ----------
DB_URL=postgres://app@localhost:5432/fbx       # Connection URL WITHOUT password · req:all · sens:C
DB_PASSWORD=app                                # Password (prod: secret://aws-sm/infrabyx/fbx/prod/db#password) · req:all · sens:S
DB_SSL_MODE=disable                            # disable|require|verify-full; verify-full from staging · req:all · sens:C
DB_MIGRATIONS_ROLE=app_migrator                # Migration role (expand→migrate→contract) · req:all · sens:C
DB_MIGRATIONS_PASSWORD=migrator                # · req:all · sens:S
DB_RLS_BYPASS_ROLE=                            # MUST be empty in prod; break-glass via SECRETS only · req:opt · sens:S
DB_PGVECTOR_DIMS=1024                          # Embedding dimension (IPB-03) · req:all · sens:C

# ---------- CACHE_ / QUEUE_ (Redis, BullMQ) ----------
CACHE_REDIS_URL=redis://localhost:6379/0       # Cache, rate limits, navigation cache · req:all · sens:C
CACHE_REDIS_TLS=false                          # true in prod · req:all · sens:C
QUEUE_REDIS_URL=redis://localhost:6379/1       # BullMQ · req:all · sens:C

# ---------- WORKFLOW_ (Temporal) ----------
WORKFLOW_TEMPORAL_ADDRESS=localhost:7233       # · req:all · sens:C
WORKFLOW_TEMPORAL_NAMESPACE=fbx-local          # Per product per env · req:all · sens:C
WORKFLOW_TEMPORAL_TLS_CERT_REF=                # secret:// client cert (Temporal Cloud Mumbai / mTLS) · req:prod · sens:S
WORKFLOW_TEMPORAL_TLS_KEY_REF=                 # secret:// client key · req:prod · sens:S
WORKFLOW_TASK_QUEUE=fbx-main                   # · req:all · sens:C
WORKFLOW_PAYLOAD_CODEC_KEY_REF=                # secret:// client-side codec key (no PII in Temporal history) · req:all · sens:S

# ---------- AUTH_ (IDENTITY port; Keycloak reference) ----------
AUTH_ADAPTER=keycloak                          # keycloak|zitadel (supabase_auth: nonprod only) · req:all · sens:C
AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-fbx  # OIDC issuer · req:all · sens:C
AUTH_CLIENT_ID=fbx-api                         # · req:all · sens:C
AUTH_CLIENT_SECRET=dev-secret                  # Literal refused in prod · req:all · sens:S
AUTH_ADMIN_CLIENT_SECRET=dev-admin-secret      # · req:nonprod · sens:S
AUTH_SESSION_COOKIE_NAME=__Host-fbx_sess       # · req:all · sens:C
AUTH_SESSION_SECRET=change-me-32-bytes-minimum # ≥32 bytes · req:all · sens:S
AUTH_MFA_REQUIRED_ROLES=PLT_SUPER_ADMIN,PLT_SECURITY_OFFICER,ORG_OWNER,ORG_ADMIN,ORG_CHECKER  # MFA mandatory for all staff in prod (Part 10.1) · req:all · sens:C
AUTH_PASSKEYS_RP_ID=localhost                  # WebAuthn RP ID · req:all · sens:C
AUTH_PASSKEYS_ORIGINS=http://localhost:3001,http://localhost:3002  # Related origins · req:all · sens:C
AUTH_SUPER_ADMIN_EMAIL=rjnprajapati@gmail.com  # Bootstrap super admin (IPB-D-04); prod: invitation link, never seeded password · req:all · sens:C
AUTH_BREAK_GLASS_ENABLED=false                 # Must be false in prod · req:opt · sens:C

# ---------- AUTHZ_ / RULES_ (Cerbos; GoRules ZEN; CEL) ----------
AUTHZ_CERBOS_URL=http://localhost:3592         # Cerbos PDP · req:all · sens:C
RULES_ADAPTER=gorules                          # gorules (credit decisions) · req:all · sens:C
RULES_GORULES_URL=http://localhost:3593        # ZEN engine service · req:all · sens:C
RULES_CEL_PACKS_PATH=./packages/rule-packs     # Versioned YAML rule packs (Part 7B RR1.3) · req:all · sens:C
RULES_PACK_SIGNING_KEY_REF=                    # secret:// signature key for rule packs (contracts.lock) · req:all · sens:S

# ---------- STORAGE_ (STORAGE port; S3 reference, MinIO local) ----------
STORAGE_ADAPTER=s3                             # s3|minio|azure_blob|gcs · req:all · sens:C
STORAGE_REGION=ap-south-1                      # · req:all · sens:C
STORAGE_BUCKET_DOCS=fbx-docs-local             # Loan documents, KFS, agreements (Object Lock in prod) · req:all · sens:C
STORAGE_BUCKET_PUBLIC=fbx-public-local         # CMS media, brand assets (Phase 21) · req:all · sens:C
STORAGE_BUCKET_EXPORTS=fbx-exports-local       # Tenant archives (Part 7J) · req:all · sens:C
STORAGE_BUCKET_LOGS=fbx-logs-local             # 180-day CERT-In logs (WORM) · req:all · sens:C
STORAGE_BUCKET_RETURNS=fbx-returns-local       # Return packages and bureau files (RR5 evidence vault) · req:all · sens:C
STORAGE_ACCESS_KEY_ID=minioadmin               # Prod uses IAM role; leave empty · req:nonprod · sens:S
STORAGE_SECRET_ACCESS_KEY=minioadmin           # · req:nonprod · sens:S
STORAGE_OBJECT_LOCK_MODE=GOVERNANCE            # GOVERNANCE|COMPLIANCE (docs, returns, logs) · req:prod · sens:C
STORAGE_KMS_KEY_REF=                           # secret:// or ARN of platform KMS key · req:prod · sens:S
STORAGE_AV_SCAN_URL=http://localhost:3310      # ClamAV/ICAP (AV port) · req:all · sens:C
STORAGE_BYOS_ALLOWED_RESIDENCY=IN              # StorageTarget residency check (Part 7J DP3) · req:all · sens:C

# ---------- SEARCH_ / DOCGEN_ ----------
SEARCH_ADAPTER=pg_fts                          # pg_fts|opensearch · req:all · sens:C
DOCGEN_GOTENBERG_URL=http://localhost:3100     # DOCX/HTML → PDF · req:all · sens:C
DOCGEN_PADES_SIGNING_KEY_REF=                  # secret:// KMS key for PAdES signatures · req:prod · sens:S

# ---------- SECRETS_ / KMS_ ----------
SECRETS_ADAPTER=env                            # env (local only)|aws_sm|vault|azure_kv|gcp_sm · req:all · sens:C
SECRETS_AWS_REGION=ap-south-1                  # · req:prod · sens:C
KMS_ADAPTER=aws_kms                            # aws_kms|pkcs11 (bank on-premise HSM) · req:all · sens:C
KMS_FIELD_ENCRYPTION_KEY_REF=                  # secret:// key for field-level encryption (PAN, account numbers) · req:all · sens:S
KMS_AADHAAR_VAULT_KEY_REF=                     # secret:// Aadhaar vault key (UIDAI Circular 14 of 2025) · req:all · sens:S

# ---------- AI_ (packages/ai gateway; IPB-03; Phase 18A) ----------
AI_ENABLED=true                                # Master switch · req:all · sens:C
AI_DEFAULT_BAND_IN_ZERO_ADAPTER=bedrock_claude_in  # CONFIDENTIAL/REGULATED (all borrower data) · req:all · sens:C
AI_REGULATED_BAND_LOCK=in_zero                 # Finbyx tightening: REGULATED may never leave in_zero · req:all · sens:C
AI_BEDROCK_REGION=ap-south-1                   # Must be ap-south-1, in-region models only · req:all · sens:C
AI_AZURE_OPENAI_ENDPOINT=                      # Bank BYOK alternative · req:opt · sens:C
AI_AZURE_OPENAI_REGION=centralindia            # Must be centralindia · req:opt · sens:C
AI_AZURE_OPENAI_API_KEY=                       # · req:opt · sens:S
AI_SPEECH_DEFAULT_STT=bhashini                 # Voice notes, captions (G.9) · req:opt · sens:C
AI_BHASHINI_API_KEY=                           # · req:opt · sens:S
AI_OBS_CAPTURE_CONTENT=false                   # Never true in prod · req:all · sens:C
AI_MCP_SERVER_ENABLED=false                    # /mcp endpoint master switch (tenant setting also required) · req:all · sens:C
AI_MCP_RESOURCE_INDICATOR=urn:infrabyx:fbx:mcp # OAuth 2.1 resource indicator · req:all · sens:C
AI_INFERENCE_CONFIDENTIAL_ONLY=false           # fut.confidential-inference (bank outsourcing policy) · req:opt · sens:C

# ---------- FBX_ (product adapters; all credential refs sens:S; mock in local/test) ----------
FBX_CIC_ADAPTER=mock                           # mock|cibil|experian|equifax|crif (BUREAU port; all four live in prod) · req:all · sens:C
FBX_CIC_CREDS_REF=                             # secret:// per-CIC member credentials (tenant-held keys for SFTP) · req:prod · sens:S
FBX_AA_FIU_ID=                                 # Account Aggregator FIU id (ReBIT) · req:opt · sens:C
FBX_AA_CLIENT_CREDS_REF=                       # secret:// · req:opt · sens:S
FBX_AA_PRIVATE_KEY_REF=                        # secret:// · req:opt · sens:S
FBX_ULI_ENABLED=false                          # fut.uli-gateway · req:opt · sens:C
FBX_DISBURSEMENT_RAIL_ADAPTER=mock             # mock|bank_api|razorpayx|cashfree_payouts (PAYOUTS/DISBURSEMENT_RAIL) · req:all · sens:C
FBX_DISBURSEMENT_CREDS_REF=                    # secret:// · req:prod · sens:S
FBX_ENACH_ADAPTER=mock                         # mock|sponsor_bank|npci_pa (mandates) · req:all · sens:C
FBX_ENACH_CREDS_REF=                           # secret:// · req:prod · sens:S
FBX_KYC_ADAPTER=mock                           # mock|surepass|digio|hyperverge (KYC port) · req:all · sens:C
FBX_KYC_CREDS_REF=                             # secret:// · req:prod · sens:S
FBX_KYC_VCIP_ADAPTER=mock                      # V-CIP provider; recordings to tenant-exclusive storage (KYC 27(1)(i)) · req:all · sens:C
FBX_KYC_VCIP_CREDS_REF=                        # secret:// · req:prod · sens:S
FBX_CKYC_CREDS_REF=                            # secret:// · req:opt · sens:S
FBX_ESIGN_ADAPTER=mock                         # mock|lawdocs|nsdl|emudhra (ESIGN port) · req:all · sens:C
FBX_ESIGN_CREDS_REF=                           # secret:// · req:prod · sens:S
FBX_GL_EXPORT_FORMAT=tally_xml                 # tally_xml|sap_idoc|csv (AC6) · req:all · sens:C
FBX_CONNECTOR_AGENT_CA_REF=                    # secret:// mTLS CA for apps/agent device certificates · req:prod · sens:S
FBX_RETURN_PORTAL_MODE=guided                  # guided (human files) — never automated; credentials never stored (7B.0) · req:all · sens:C
FBX_SEED_LOAN_COUNT=500                        # dev 500 · demo 20000 · load 1000000 (IPB-11 §11.7) · req:nonprod · sens:C

# ---------- PAYMENTS_ (PAYMENTS port — tenant subscription billing only; IPB-D-07; OH8 engine of record) ----------
PAYMENTS_ADAPTER=razorpay                      # razorpay|cashfree · req:all · sens:C
PAYMENTS_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx     # Test prefix refused in prod · req:opt · sens:C
PAYMENTS_RAZORPAY_KEY_SECRET=                  # · req:opt · sens:S
PAYMENTS_RAZORPAY_WEBHOOK_SECRET=              # Signature verification (CM4.3) · req:opt · sens:S
PAYMENTS_HOSTED_CHECKOUT_ONLY=true             # Must be true (PCI DSS SAQ A) · req:all · sens:C
PAYMENTS_BILLING_ENGINE_URL=http://localhost:4100  # Operations Hub OH8 · req:all · sens:C
PAYMENTS_BILLING_ENGINE_TOKEN_REF=             # secret:// · req:all · sens:S
PAYMENTS_CATALOGUE_SIGNING_PUBKEY_REF=         # secret:// OH8 catalogue public key (CM1.1; Pricing Studio) · req:all · sens:S

# ---------- MSG_ (NOTIFY fan-out: EMAIL, SMS, WHATSAPP, PUSH, VOICE ports) ----------
MSG_EMAIL_ADAPTER=smtp                         # smtp (MailHog local)|ses|postmark · req:all · sens:C
MSG_SMTP_URL=smtp://localhost:1025             # MailHog locally; credentials via secret:// in staging · req:nonprod · sens:C
MSG_EMAIL_FROM=no-reply@localhost              # Platform default; brand packs override per host (Part 3.3.1) · req:all · sens:C
MSG_EMAIL_DKIM_KEY_REF=                        # secret:// DKIM key (platform domain) · req:prod · sens:S
MSG_SMS_ADAPTER=none                           # none|msg91|kaleyra (tenant is DLT principal entity) · req:all · sens:C
MSG_WHATSAPP_ADAPTER=none                      # none|meta_cloud|bsp — servicing only; super-admin toggle mkt.whatsapp.enabled · req:all · sens:C
MSG_WHATSAPP_ACCESS_TOKEN_REF=                 # secret:// · req:opt · sens:S
MSG_VOICE_ADAPTER=none                         # none|exotel|ozonetel|jiocx_stub (EO6; 1600/140-series rules) · req:all · sens:C
MSG_VOICE_CREDS_REF=                           # secret:// · req:opt · sens:S
MSG_PUSH_FCM_SA_KEY_REF=                       # secret:// (field app, borrower portal) · req:opt · sens:S
MSG_WEBHOOK_SIGNING_SECRET_REF=                # secret:// Standard Webhooks outbound key (M21) · req:all · sens:S

# ---------- OBS_ (OpenTelemetry, errors, logs) ----------
OBS_OTLP_ENDPOINT=http://localhost:4318        # · req:all · sens:C
OBS_SERVICE_NAMESPACE=infrabyx                 # · req:all · sens:C
OBS_TRACE_SAMPLE_RATIO=1.0                     # 0.1 in prod · req:all · sens:C
OBS_LOG_LEVEL=debug                            # info in prod · req:all · sens:C
OBS_LOG_FORMAT=pretty                          # json in prod · req:all · sens:C
OBS_PII_SCRUB_PATTERNS=aadhaar,pan,card,account,otp  # Log scrubber classes (Part 10.2 principle 14) · req:all · sens:C
OBS_LOG_RETENTION_DAYS=180                     # CERT-In minimum · req:all · sens:C
OBS_AUDIT_HASH_CHAIN_KEY_REF=                  # secret:// HMAC key for audit ledger chain (AC7) · req:all · sens:S

# ---------- FLAGS_ (FEATURE_FLAG port; OpenFeature) ----------
FLAGS_ADAPTER=file                             # file|unleash|flagsmith · req:all · sens:C
FLAGS_FILE_PATH=./config/flags.local.json      # mod./exp./ops./kill./fut. taxonomy · req:nonprod · sens:C

# ---------- IPB_ (shared cross-product; Ecosystem Spec v1.2) ----------
IPB_ECOSYSTEM_BUS_URL=nats://localhost:4222    # CloudEvents bus · req:all · sens:C
IPB_ECOSYSTEM_BUS_CREDS_REF=                   # secret:// · req:prod · sens:S
IPB_OPS_HUB_URL=http://localhost:4100          # Operations Hub (billing, TRUST, SUPPORT, CRM, HR, consent) · req:all · sens:C
IPB_OPS_HUB_TOKEN_REF=                         # secret:// · req:all · sens:S
IPB_BRAND_PACK_SOURCE=db                       # db|ops_hub · req:all · sens:C
IPB_LAW_REGISTER_URL=                          # LDC legal rules register (LAW_REGISTER port; hlp citation watch) · req:opt · sens:C
IPB_DATA_RESIDENCY=IN                          # Declared residency · req:all · sens:C
IPB_CERTIN_REPORT_EMAIL=                       # Incident reporting mailbox (6-hour clock) · req:prod · sens:C
IPB_GLOBAL_ADAPTER_MAX_CLASS=PUBLIC            # Finbyx tightening: GLOBAL adapters only for PUBLIC data · req:all · sens:C

# ---------- SEED_ (non-production only; IPB-11 §11.3.D) ----------
SEED_ENABLED=true                              # MUST be false/unset in prod/dr (boot refuses: IPB-ENV-001) · req:nonprod · sens:C
SEED_PROFILE=dev                               # dev|demo|test|load · req:nonprod · sens:C
SEED_RANDOM_SEED=20261026                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./SEED_CREDENTIALS.md    # Output path (gitignored; mode 0600) · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/fbx/local/seed  # Seed vault path · req:nonprod · sens:C
SEED_SYNTHETIC_ID_PREFIX=TEST                  # Synthetic PAN/mobile/account prefixes (IPB-11-25) · req:nonprod · sens:C

# ---------- Browser-exposed (apps/web, apps/public, apps/console, borrower portal) ----------
NEXT_PUBLIC_APP_ENV=local                      # · req:all · sens:P
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000 # · req:all · sens:P
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-fbx  # · req:all · sens:P
NEXT_PUBLIC_AUTH_CLIENT_ID=fbx-web             # · req:all · sens:P
NEXT_PUBLIC_PRODUCT=FBX                        # · req:all · sens:P
NEXT_PUBLIC_CMP_ENABLED=true                   # Cookie consent manager (Phase 21) · req:all · sens:P
NEXT_PUBLIC_ANALYTICS_ID=                      # Consent-gated; never on authenticated routes · req:opt · sens:P
NEXT_PUBLIC_TAG_MANAGER_ADAPTER=none           # none|gtm_web|gtm_server (owner decision; Appendix B 57) · req:opt · sens:P
NEXT_PUBLIC_STATUS_PAGE_URL=                   # Footer and Trust Centre link · req:opt · sens:P

# ---------- Mobile (Expo; Finbyx field app) ----------
EXPO_PUBLIC_APP_ENV=local                      # · req:all · sens:P
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000  # Android emulator host · req:all · sens:P
EXPO_PUBLIC_AUTH_ISSUER_URL=http://10.0.2.2:8080/realms/infrabyx-fbx  # · req:all · sens:P
EXPO_PUBLIC_AUTH_CLIENT_ID=fbx-field           # · req:all · sens:P
EXPO_PUBLIC_PRODUCT=FBX                        # · req:all · sens:P
EXPO_PUBLIC_OFFLINE_SYNC_HOURS=72              # Forced-sync window (G.9) · req:all · sens:P
