############################################################
# Infrabyx Operations Hub (OH) — environment template v1.1 (26 October 2026)
# Derived from IPB-11 §11.4.3 (v1.0). Generated by `pnpm env:example` from env.schema.ts in the
# repository; this hand-written copy is the starting point for Phase O1 and must match the generator
# output afterwards (CI fails on drift, IPB-11-03).
# Columns in each comment: description · req: environments where required (all|nonprod|prod|opt) · sens: S/C/P
# Secrets (sens:S) MUST be secret:// references in staging/demo/prod/dr (IPB-11-15). Never commit real values.
# Production guard-rails (IPB-11-14..21): APP_ENV=prod|dr → NODE_ENV=production, SEED_* unset/false,
# no localhost/.test/http:// URLs, DB_SSL_MODE=verify-full, India regions only for AI adapters.
############################################################

# ---------- APP_ (process identity, URLs) ----------
APP_ENV=local                                  # local|dev|test|staging|demo|prod|dr · req:all · sens:C
NODE_ENV=development                           # must be production when APP_ENV=prod|dr · req:all · sens:C
APP_PRODUCT=OH                                 # Product code · req:all · sens:C
APP_NAME=ops-hub-api                           # Process name for logs / OTel service.name · req:all · sens:C
APP_VERSION=0.0.0-local                        # Set by CI from Changesets; shown in /health · req:all · sens:C
APP_GIT_SHA=local                              # Commit SHA from CI · req:all · sens:C
APP_PORT=4100                                  # HTTP listen port (OH8 billing engine URL for siblings) · req:all · sens:C
APP_HOST=0.0.0.0                               # Bind address · req:all · sens:C
APP_BASE_URL=http://localhost:4100             # API base URL; https and host-map match in prod · req:all · sens:C
APP_PUBLIC_URL=http://localhost:3100           # Group public site (apps/public, OH18) · req:all · sens:C
APP_WEB_URL=http://localhost:3101              # Staff app (apps/web) · req:all · sens:C
APP_CONSOLE_URL=http://localhost:3102          # Super-admin console (apps/console) · req:all · sens:C
APP_TRUST_PROXY=1                              # Trusted proxy hops · req:all · sens:C
APP_CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102  # Comma list · req:all · sens:C
APP_DEFAULT_TZ=Asia/Kolkata                    # Schedules and display · req:all · sens:C
APP_DEFAULT_LOCALE=en-IN                       # Default locale (hi-IN supported) · req:all · sens:C
APP_REGION=ap-south-1                          # Deployment region label · req:all · sens:C

# ---------- DB_ (PostgreSQL only; IPB-D-02; forced RLS on legal_entity_id + product_scope) ----------
DB_URL=postgres://app@localhost:5432/oh        # Connection URL WITHOUT password · req:all · sens:C
DB_PASSWORD=app                                # Password · req:all · sens:S  (prod: secret://aws-sm/infrabyx/oh/prod/db#password)
DB_SSL_MODE=disable                            # disable|require|verify-full (verify-full in staging/prod/dr) · req:all · sens:C
DB_SSL_CA_REF=                                 # secret:// CA bundle when verify-full · req:prod · sens:S
DB_MIGRATIONS_ROLE=app_migrator                # Expand→migrate→contract role · req:all · sens:C
DB_MIGRATIONS_PASSWORD=migrator                # · req:all · sens:S
DB_RLS_BYPASS_ROLE=                            # MUST be empty in prod; break-glass via SECRETS only · req:opt · sens:S
DB_PGVECTOR_DIMS=1024                          # Embedding dimension for Vidhi retrieval (OH16) · req:all · sens:C

# ---------- CACHE_ / QUEUE_ (Redis, BullMQ) ----------
CACHE_REDIS_URL=redis://localhost:6379/0       # Cache and rate limits · req:all · sens:C
CACHE_REDIS_PASSWORD=                          # · req:prod · sens:S
QUEUE_REDIS_URL=redis://localhost:6379/1       # BullMQ · req:all · sens:C

# ---------- WORKFLOW_ (Temporal: payroll, joiner/leaver, provisioning, dunning, cadence, publication) ----------
WORKFLOW_TEMPORAL_ADDRESS=localhost:7233       # · req:all · sens:C
WORKFLOW_TEMPORAL_NAMESPACE=oh-local           # Namespace per env · req:all · sens:C
WORKFLOW_TASK_QUEUE=oh-main                    # Default task queue · req:all · sens:C
WORKFLOW_PAYROLL_TASK_QUEUE=oh-payroll         # Isolated queue for payroll runs (OH10) · req:all · sens:C

# ---------- AUTH_ (IDENTITY port; Keycloak broker federating Entra ID / Google) ----------
AUTH_ADAPTER=keycloak                          # keycloak|entra|google_identity · req:all · sens:C
AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-oh  # OIDC issuer; https in prod · req:all · sens:C
AUTH_CLIENT_ID=oh-api                          # · req:all · sens:C
AUTH_CLIENT_SECRET=dev-secret                  # Refused literal in staging/prod · req:all · sens:S
AUTH_ADMIN_CLIENT_ID=oh-admin                  # Keycloak admin API (seeds, SCIM) · req:nonprod · sens:C
AUTH_ADMIN_CLIENT_SECRET=dev-admin-secret      # · req:nonprod · sens:S
AUTH_FEDERATION_ENTRA_TENANT_ID=               # Entra ID tenant for staff SSO (Appendix B decision 1) · req:opt · sens:C
AUTH_FEDERATION_ENTRA_CLIENT_ID=               # · req:opt · sens:C
AUTH_FEDERATION_ENTRA_CLIENT_SECRET_REF=       # secret:// · req:opt · sens:S
AUTH_FEDERATION_GOOGLE_CLIENT_ID=              # Google Cloud Identity federation (second adapter) · req:opt · sens:C
AUTH_FEDERATION_GOOGLE_CLIENT_SECRET_REF=      # secret:// · req:opt · sens:S
AUTH_SESSION_COOKIE_NAME=__Host-oh_sess        # · req:all · sens:C
AUTH_SESSION_SECRET=change-me-32-bytes-minimum # ≥32 bytes · req:all · sens:S
AUTH_SESSION_TTL_MIN=30                        # Idle timeout (OH1 default 30; privileged 15 via policy) · req:opt · sens:C
AUTH_MFA_REQUIRED_ROLES=ALL                    # Hub: MFA for every account (OH1.2) · req:all · sens:C
AUTH_PASSKEY_REQUIRED_ROLES=PLT_SUPER_ADMIN,PLT_SECURITY_OFFICER,OPS_ADMIN,OPS_FINANCE,OPS_HR,OPS_PAYROLL  # Passkeys for privileged/OPS roles · req:all · sens:C
AUTH_PASSKEYS_RP_ID=localhost                  # WebAuthn RP ID · req:all · sens:C
AUTH_PASSKEYS_ORIGINS=http://localhost:3101,http://localhost:3102  # Allowed origins · req:all · sens:C
AUTH_SCIM_BEARER_REF=                          # secret:// inbound SCIM token (IdP → Hub) · req:opt · sens:S
AUTH_SCIM_OUTBOUND_TARGETS=                    # Comma list of product SCIM endpoints (group grants with valid_to) · req:opt · sens:C
AUTH_SUPER_ADMIN_EMAIL=rjnprajapati@gmail.com  # Bootstrap super admin (IPB-D-04) · req:all · sens:C
AUTH_BREAK_GLASS_ENABLED=false                 # Must be false in prod · req:opt · sens:C

# ---------- AUTHZ_ / RULES_ (Cerbos; GoRules ZEN or CEL; signed rule packs) ----------
AUTHZ_CERBOS_URL=http://localhost:3592         # Cerbos PDP (grants, DoA, product_scope) · req:all · sens:C
RULES_ADAPTER=gorules                          # gorules|cel · req:all · sens:C
RULES_GORULES_URL=http://localhost:3593        # ZEN engine · req:all · sens:C
RULES_PACK_REGISTRY_URL=https://contracts.infrabyx.internal/rulepacks  # infrabyx-contracts rule-pack registry · req:all · sens:C
RULES_PACK_SIGNING_PUBKEY_REF=                 # secret:// JWS public key for pack verification · req:all · sens:S
RULES_LABOUR_PACK_PIN=infrabyx-labour-rulepack@1.0.0  # Pinned shared Labour Code pack (contracts.lock mirror) · req:all · sens:C
RULES_TDS_PACK_PIN=ita25-salary-tds@1.0.0      # Pinned salary TDS pack · req:all · sens:C

# ---------- STORAGE_ (S3 reference, MinIO local; Object Lock for docs, payroll, trust) ----------
STORAGE_ADAPTER=s3                             # s3|azure_blob|gcs|minio · req:all · sens:C
STORAGE_ENDPOINT=http://localhost:9000         # MinIO local; empty for AWS · req:nonprod · sens:C
STORAGE_REGION=ap-south-1                      # · req:all · sens:C
STORAGE_BUCKET_DOCS=oh-docs-local              # Documents (Object Lock in prod) · req:all · sens:C
STORAGE_BUCKET_PUBLIC=oh-public-local          # CMS and DAM public assets · req:all · sens:C
STORAGE_BUCKET_EXPORTS=oh-exports-local        # Archive-standard exports (oh_entity_v1) · req:all · sens:C
STORAGE_BUCKET_LOGS=oh-logs-local              # 180-day CERT-In logs (WORM) · req:all · sens:C
STORAGE_BUCKET_PAYROLL=oh-payroll-local        # RESTRICTED payroll artefacts (payslips, bank files); separate KMS key · req:all · sens:C
STORAGE_BUCKET_TRUST=oh-trust-local            # Vendor Assurance Room originals (Object Lock COMPLIANCE in prod; shared read for product mirrors) · req:all · sens:C
STORAGE_BUCKET_AUDIT_ANCHORS=oh-audit-anchors-local  # Daily audit-chain head hashes (Object Lock) · req:all · sens:C
STORAGE_ACCESS_KEY_ID=minioadmin               # Prod uses IAM role; leave empty · req:nonprod · sens:S
STORAGE_SECRET_ACCESS_KEY=minioadmin           # · req:nonprod · sens:S
STORAGE_OBJECT_LOCK_MODE=GOVERNANCE            # GOVERNANCE|COMPLIANCE (trust bucket COMPLIANCE) · req:prod · sens:C
STORAGE_KMS_KEY_REF=                           # secret:// or ARN default KMS key · req:prod · sens:S
STORAGE_KMS_KEY_PAYROLL_REF=                   # secret:// per-class key for RESTRICTED HR/payroll · req:prod · sens:S
STORAGE_AV_SCAN_URL=http://localhost:3310      # ClamAV/ICAP (AV port) · req:all · sens:C

# ---------- SEARCH_ ----------
SEARCH_ADAPTER=pg_fts                          # pg_fts|opensearch · req:all · sens:C

# ---------- DOCGEN_ / MEDIA_ (letters, payslips, invoices, watermarks; image processing) ----------
DOCGEN_GOTENBERG_URL=http://localhost:3000     # PDF conversion · req:all · sens:C
DOCGEN_PDFA_ENABLED=true                       # PDF/A for archival (payslips, assurance docs) · req:opt · sens:C
DOCGEN_WATERMARK_SIGNING_KEY_REF=              # secret:// key for XMP acknowledgement stamps (OH18.4) · req:all · sens:S
MEDIA_STRIP_EXIF=true                          # Always strip EXIF on upload · req:all · sens:C

# ---------- SECRETS_ ----------
SECRETS_ADAPTER=env                            # env (local only)|aws_sm|azure_kv|gcp_sm|vault|sops · req:all · sens:C
SECRETS_AWS_REGION=ap-south-1                  # · req:prod · sens:C

# ---------- AI_ (packages/vidhi + gateway; IPB-03; OH16) ----------
AI_ENABLED=true                                # Master switch · req:all · sens:C
AI_DEFAULT_BAND_OPEN_ADAPTER=anthropic_direct  # PUBLIC/INTERNAL band · req:all · sens:C
AI_DEFAULT_BAND_IN_ZERO_ADAPTER=bedrock_claude_in  # CONFIDENTIAL/RESTRICTED band (India, zero retention) · req:all · sens:C
AI_DEFAULT_BAND_SELF_ADAPTER=self_hosted_vllm  # SECRET band · req:all · sens:C
AI_ANTHROPIC_API_KEY=                          # · req:opt · sens:S
AI_BEDROCK_REGION=ap-south-1                   # Must be ap-south-1 (IPB-11-20) · req:all · sens:C
AI_AZURE_OPENAI_ENDPOINT=                      # · req:opt · sens:C
AI_AZURE_OPENAI_REGION=centralindia            # Must be centralindia · req:opt · sens:C
AI_AZURE_OPENAI_API_KEY=                       # · req:opt · sens:S
AI_VERTEX_PROJECT_ID=                          # Gemini/Imagen (IMAGE_GEN reference) · req:opt · sens:C
AI_VERTEX_REGION=asia-south1                   # Must be asia-south1 · req:opt · sens:C
AI_VERTEX_SA_KEY_REF=                          # secret:// · req:opt · sens:S
AI_VLLM_BASE_URL=http://localhost:8000/v1      # self_hosted_vllm · req:opt · sens:C
AI_IMAGE_DEFAULT_ADAPTER=gemini_imagen         # IMAGE_GEN default (Appendix B decision 28) · req:opt · sens:C
AI_IMAGE_HUMAN_APPROVAL_REQUIRED=true          # Floor: synthetic images need human approval (OH17.5) · req:all · sens:C
AI_C2PA_SIGNING_KEY_REF=                       # secret:// C2PA manifests for synthetic media · req:opt · sens:S
AI_EVAL_JUDGE_ADAPTER=bedrock_claude_in        # Eval judge (never model under test) · req:nonprod · sens:C
AI_OBS_CAPTURE_CONTENT=false                   # Never true in prod · req:all · sens:C
AI_MCP_SERVER_ENABLED=false                    # /mcp server master switch (OH16.6; stays off until OP) · req:all · sens:C
AI_MCP_RESOURCE_INDICATOR=urn:infrabyx:oh:mcp  # OAuth 2.1 resource indicator · req:all · sens:C
AI_EGRESS_PROXY_URL=http://localhost:3128      # EGRESS allow-list proxy for notebook URL sources, embeds, webhooks · req:all · sens:C
AI_EGRESS_ALLOWLIST_PATH=./config/egress-allowlist.local.json  # Allow-list file (Regulated change in prod) · req:all · sens:C

# ---------- PAYMENTS_ (Razorpay reference; OH8 is the billing engine of record; hosted checkout only) ----------
PAYMENTS_ADAPTER=razorpay                      # razorpay|payu|cashfree · req:all · sens:C
PAYMENTS_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx     # Test prefix refused in prod · req:opt · sens:C
PAYMENTS_RAZORPAY_KEY_SECRET=                  # · req:opt · sens:S
PAYMENTS_RAZORPAY_WEBHOOK_SECRET=              # · req:opt · sens:S
PAYMENTS_RAZORPAY_WEBHOOK_SECRET_PREVIOUS=     # Old secret valid for retries after rotation · req:opt · sens:S
PAYMENTS_PAYU_MERCHANT_KEY=                    # Second adapter · req:opt · sens:C
PAYMENTS_PAYU_SALT_REF=                        # secret:// · req:opt · sens:S
PAYMENTS_HOSTED_CHECKOUT_ONLY=true             # Must be true (PCI DSS SAQ A) · req:all · sens:C
OH_BILLING_ENGINE_MODE=primary                 # OH8 is the engine; siblings point PAYMENTS_BILLING_ENGINE_URL here · req:all · sens:C
OH_CATALOGUE_SIGNING_KEY_REF=                  # secret:// JWS key for the signed catalogue and entitlements · req:all · sens:S

# ---------- GST_ / EINVOICE_ / ACCOUNTING_ (OH8, OH10 journals) ----------
OH_GST_API_ADAPTER=offline_json                # offline_json|gsp · req:all · sens:C
OH_GST_CREDS_REF=                              # secret:// GSP credentials (never portal passwords) · req:opt · sens:S
OH_EINVOICE_IRP_CREDS_REF=                     # secret:// IRP API user · req:opt · sens:S
OH_ACCOUNTING_ADAPTER=tally                    # tally|zoho_books (ACCOUNTING port) · req:all · sens:C
OH_ACCOUNTING_TALLY_URL=http://localhost:9000  # TallyPrime listener (never beyond localhost) · req:opt · sens:C

# ---------- PAYROLL_ / STATUTORY_ (OH10; mock adapters in non-prod; no portal credentials or OTPs ever) ----------
OH_PAYROLL_ENGINE_MODE=engine                  # engine|provider (Appendix B decision 6/21) · req:all · sens:C
OH_PAYROLL_PROVIDER_ADAPTER=                   # Provider adapter key when mode=provider (India-resident, DPA) · req:opt · sens:C
OH_PAYROLL_PROVIDER_CREDS_REF=                 # secret:// · req:opt · sens:S
OH_PAYROLL_PF_CREDS_REF=                       # secret:// EPFO ECR upload credentials (machine channel only if documented) · req:opt · sens:S
OH_PAYROLL_ESI_CREDS_REF=                      # secret:// · req:opt · sens:S
OH_PAYOUT_FILE_ADAPTER=mock_bank               # Bank bulk-file format adapter (PayoutFileProvider) · req:all · sens:C
OH_PAYSLIP_WATERMARK=true                      # Watermark payslips with employee name · req:all · sens:C
OH_GEOFENCE_FEATURE_ENABLED=false              # Opt-in geofence feature switch (office arrangements only) · req:all · sens:C

# ---------- MSG_ (NOTIFY port: email, SMS, WhatsApp, push, Teams/Chat) ----------
MSG_EMAIL_ADAPTER=smtp                         # smtp|ses · req:all · sens:C
MSG_SMTP_HOST=localhost                        # MailHog locally · req:nonprod · sens:C
MSG_SMTP_PORT=1025                             # · req:nonprod · sens:C
MSG_EMAIL_FROM=no-reply@localhost              # Brand domain in prod · req:all · sens:C
MSG_EMAIL_DKIM_KEY_REF=                        # secret:// · req:prod · sens:S
MSG_SMS_ADAPTER=none                           # none|msg91|kaleyra|jiocx · req:all · sens:C
MSG_SMS_API_KEY=                               # · req:opt · sens:S
MSG_SMS_DLT_ENTITY_ID=                         # TRAI DLT principal-entity id · req:opt · sens:C
MSG_WHATSAPP_ADAPTER=none                      # none|meta_cloud|bsp (Appendix B decision 24) · req:all · sens:C
MSG_WHATSAPP_PHONE_NUMBER_ID=                  # · req:opt · sens:C
MSG_WHATSAPP_ACCESS_TOKEN_REF=                 # secret:// · req:opt · sens:S
MSG_WHATSAPP_VERIFY_TOKEN=                     # Webhook verify token · req:opt · sens:S
MSG_WHATSAPP_APP_SECRET_REF=                   # secret:// for X-Hub-Signature-256 verification · req:opt · sens:S
MSG_TEAMS_ADAPTER=none                         # none|graph_bot|webhook (OH12.9 adaptive cards) · req:all · sens:C
MSG_TEAMS_BOT_APP_ID=                          # · req:opt · sens:C
MSG_TEAMS_BOT_SECRET_REF=                      # secret:// · req:opt · sens:S
MSG_GOOGLE_CHAT_WEBHOOK_REF=                   # secret:// Chat webhook (Google adapter) · req:opt · sens:S
MSG_WEBHOOK_SIGNING_SECRET_REF=                # secret:// Standard Webhooks outbound signing key · req:all · sens:S

# ---------- OH_MKT_ (OH17 marketing execution; all off or mock by default) ----------
OH_MKT_META_ENABLED=false                      # Mirrors setting mkt.meta.enabled; must be false until OP · req:all · sens:C
OH_MKT_META_APP_ID=                            # Meta app for WABA, ads, CTWA · req:opt · sens:C
OH_MKT_META_APP_SECRET_REF=                    # secret:// · req:opt · sens:S
OH_MKT_META_ADS_TOKEN_REF=                     # secret:// system-user token for Marketing API · req:opt · sens:S
OH_MKT_GOOGLE_ADS_DEVELOPER_TOKEN_REF=         # secret:// · req:opt · sens:S
OH_MKT_GOOGLE_ADS_OAUTH_CLIENT_REF=            # secret:// · req:opt · sens:S
OH_MKT_LINKEDIN_CLIENT_ID=                     # Marketing API and page publishing · req:opt · sens:C
OH_MKT_LINKEDIN_CLIENT_SECRET_REF=             # secret:// · req:opt · sens:S
OH_MKT_X_CLIENT_ID=                            # X API (publishing) · req:opt · sens:C
OH_MKT_X_CLIENT_SECRET_REF=                    # secret:// · req:opt · sens:S
OH_MKT_YOUTUBE_OAUTH_CLIENT_REF=               # secret:// · req:opt · sens:S
OH_MKT_GBP_OAUTH_CLIENT_REF=                   # secret:// Google Business Profile · req:opt · sens:S
OH_MKT_SEARCH_CONSOLE_SA_KEY_REF=              # secret:// read-only search-console adapter · req:opt · sens:S
OH_MKT_TAG_MANAGER_ADAPTER=none                # none|gtm_web|gtm_server (Appendix B decision 27) · req:all · sens:C
OH_MKT_GTM_CONTAINER_ID=                       # · req:opt · sens:C
OH_MKT_ANALYTICS_ADAPTER=none                  # none|matomo|posthog|plausible|ga4 · req:all · sens:C
OH_MKT_CRM_MARKETING_ADAPTER=brevo             # CRM_MARKETING port reference (OH3/OH7) · req:all · sens:C
OH_MKT_BREVO_API_KEY=                          # · req:opt · sens:S
OH_MKT_BREVO_WEBHOOK_SECRET_REF=               # secret:// · req:opt · sens:S

# ---------- OH_WS_ (WORKSPACE port: Microsoft Graph reference, Google Workspace) ----------
OH_WS_PROVIDER=m365                            # m365|google (per domain; Appendix B decision 1) · req:all · sens:C
OH_WS_M365_TENANT_ID=                          # · req:opt · sens:C
OH_WS_M365_CLIENT_ID=                          # Graph app (application permissions, least privilege) · req:opt · sens:C
OH_WS_M365_CLIENT_SECRET_REF=                  # secret:// (prefer certificate) · req:opt · sens:S
OH_WS_M365_DEFAULT_GEOGRAPHY=IN                # Residency attestation expectation · req:all · sens:C
OH_WS_GRAPH_NOTIFICATION_URL=                  # Public change-notification endpoint · req:opt · sens:C
OH_WS_GRAPH_CLIENT_STATE_REF=                  # secret:// clientState for notifications · req:opt · sens:S
OH_WS_GOOGLE_SA_KEY_REF=                       # secret:// domain-wide delegation SA (non-regulated data only) · req:opt · sens:S
OH_WS_GOOGLE_ADMIN_SUBJECT=                    # Admin to impersonate · req:opt · sens:C
OH_WS_MAIL_SEND_MODE=draft_only                # Floor: draft_only · req:all · sens:C
OH_WS_TRANSCRIPT_CONSENT_REQUIRED=true         # Floor · req:all · sens:C

# ---------- OH_ENG_ (OH13 evidence sources) ----------
OH_ENG_GITHUB_APP_ID=                          # Read-only GitHub App (rulesets, alerts, deployments) · req:opt · sens:C
OH_ENG_GITHUB_APP_PRIVATE_KEY_REF=             # secret:// · req:opt · sens:S

# ---------- OH_TRUST_ / OH_CMS_ / OH_FB_ (OH18) ----------
OH_VENDOR_ASSURANCE_BUCKET=oh-trust-local      # Alias of STORAGE_BUCKET_TRUST for product mirrors · req:all · sens:C
OH_TRUST_MANIFEST_SIGNING_KEY_REF=             # secret:// evidence-pack manifest signing key · req:all · sens:S
OH_TRUST_GRANTEE_REALM=infrabyx-oh-grantees    # Isolated Keycloak realm for auditor grantees (magic link + OTP) · req:all · sens:C
OH_TRUST_RETENTION_YEARS=10                    # Floor 8 · req:all · sens:C
OH_CMS_HOST_MAP_PATH=./config/host-map.local.json  # Brand-pack host map for host-header validation · req:all · sens:C
OH_CMS_PREVIEW_SIGNING_KEY_REF=                # secret:// signed preview URLs · req:all · sens:S
OH_CMS_PLAGIARISM_ADAPTER=internal             # internal|copyscape · req:opt · sens:C
OH_CMS_LAW_REGISTER_URL=                       # LAW_REGISTER port (LDC read-only) for hlp citations · req:opt · sens:C
OH_FB_INBOUND_SECRET_REF=                      # secret:// feedback widget signature (products → OH) · req:all · sens:S
OH_SUPPORT_INBOUND_EMAIL=support@localhost     # Role mailbox read for ticket intake (OH6, OH12.9) · req:all · sens:C
OH_CRM_IMPORT_BUCKET=oh-crm-import-local       # CRM import staging (dry run, reject files) · req:all · sens:C
OH_PRODUCT_SCOPE_ENFORCEMENT=true              # Floor: always true, including local (IPB-D-12) · req:all · sens:C
OH_PRODUCT_SCOPE_CODES=LD,LDC,EQ,FBX,UDF,TRN,HSP,GRP  # Scope codes (Part 3.3A) · req:all · sens:C

# ---------- OBS_ (OpenTelemetry, logs, audit chain) ----------
OBS_OTLP_ENDPOINT=http://localhost:4318        # · req:all · sens:C
OBS_SERVICE_NAMESPACE=infrabyx                 # · req:all · sens:C
OBS_TRACE_SAMPLE_RATIO=1.0                     # 0.1 in prod · req:all · sens:C
OBS_LOG_LEVEL=debug                            # info in prod · req:all · sens:C
OBS_LOG_FORMAT=pretty                          # json in prod · req:all · sens:C
OBS_ERRORS_DSN=                                # Error tracking DSN (no personal data) · req:opt · sens:S
OBS_METRICS_PORT=9464                          # Prometheus scrape port · req:opt · sens:C
OBS_LOG_RETENTION_DAYS=180                     # CERT-In minimum · req:all · sens:C
OBS_AUDIT_HASH_CHAIN_KEY_REF=                  # secret:// HMAC key for the audit ledger · req:all · sens:S
OBS_NTP_SOURCES=samay1.nic.in,samay2.nic.in    # NTP sources (CERT-In) · req:all · sens:C

# ---------- FLAGS_ (OpenFeature) ----------
FLAGS_ADAPTER=file                             # file|unleash|flagsmith · req:all · sens:C
FLAGS_FILE_PATH=./config/flags.local.json      # fut.* flags seeded OFF · req:nonprod · sens:C

# ---------- IPB_ (shared cross-product; Ecosystem Spec v1.2) ----------
IPB_ECOSYSTEM_BUS_URL=nats://localhost:4222    # CloudEvents bus · req:all · sens:C
IPB_ECOSYSTEM_BUS_CREDS_REF=                   # secret:// · req:prod · sens:S
IPB_EVENT_SOURCE_PREFIX=urn:infrabyx:oh        # source = urn:infrabyx:oh:[legalentityid] · req:all · sens:C
IPB_EVENT_SIGNING_KEY_REF=                     # secret:// JWS/RFC 9421 key for signed events · req:all · sens:S
IPB_BRAND_PACK_SOURCE=db                       # db (OH owns the group pack; reads product packs by API) · req:all · sens:C
IPB_DATA_RESIDENCY=IN                          # Declared residency · req:all · sens:C
IPB_CERTIN_REPORT_EMAIL=                       # Incident reporting mailbox · req:prod · sens:C
IPB_LDC_GROUP_TENANT_URL=                      # LDC_GROUP tenant API (PolicyAttested, AI register) · req:opt · sens:C
IPB_LDC_GROUP_TOKEN_REF=                       # secret:// · req:opt · sens:S
IPB_LD_API_URL=                                # LawDocs API for policy hand-off and eSign (OH16.3, certificates) · req:opt · sens:C
IPB_LD_TOKEN_REF=                              # secret:// · req:opt · sens:S

# ---------- SEED_ (non-production only; IPB-11 §11.3.D) ----------
SEED_ENABLED=true                              # Must be false/unset in prod/dr · req:nonprod · sens:C
SEED_PROFILE=dev                               # dev|demo|test|load; MUST be unset in prod/dr · req:nonprod · sens:C
SEED_RANDOM_SEED=20261026                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./SEED_CREDENTIALS.md    # Output path (gitignored; ruleset-blocked) · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/oh/local/seed  # Seed vault path · req:nonprod · sens:C
SEED_SIBLING_PRODUCTS_AS_CUSTOMERS=true        # Seed LD, LDC, EQ, FBX, UDF as customers and Demo Co as client · req:nonprod · sens:C

# ---------- Browser-exposed (apps/web, apps/public, apps/console) ----------
NEXT_PUBLIC_APP_ENV=local                      # · req:all · sens:P
NEXT_PUBLIC_API_BASE_URL=http://localhost:4100 # · req:all · sens:P
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-oh  # · req:all · sens:P
NEXT_PUBLIC_AUTH_CLIENT_ID=oh-web              # Public client · req:all · sens:P
NEXT_PUBLIC_PRODUCT=OH                         # · req:all · sens:P
NEXT_PUBLIC_CMP_ENABLED=true                   # Cookie consent manager on public routes · req:all · sens:P
NEXT_PUBLIC_ANALYTICS_ID=                      # Consent-gated; never on authenticated routes · req:opt · sens:P
NEXT_PUBLIC_BRAND_PRIMARY=#1F2937              # Charcoal (IPB-D-11) · req:all · sens:P
NEXT_PUBLIC_BRAND_ACCENT=#2563EB               # Electric blue · req:all · sens:P
