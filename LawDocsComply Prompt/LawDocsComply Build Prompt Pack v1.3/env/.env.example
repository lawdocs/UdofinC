############################################################
# Infrabyx LawDocsComply (LDC) — environment template
# Generated by `pnpm env:example` from env.schema.ts; do not edit by hand (CI fails if the committed file differs).
# IPB-11 v1.0 · LawDocsComply Build Prompt Pack v1.3 · 26 October 2026
# Columns in each comment: description · req: environments where required (all|nonprod|prod|opt) · sens: S secret / C config / P public
# Secrets (sens:S) MUST be secret:// references in staging, demo, prod and dr (boot exits 78 on a literal — IPB-11-15; LDC-ENG-009).
# Seeds and SEED_* MUST be unset in prod/dr (NN-61; IPB-11-14; LDC-ENG-010).
############################################################

# ---------- APP_ (process identity, URLs) ----------
APP_ENV=local                                  # local|dev|test|staging|demo|prod|dr · req:all · sens:C
NODE_ENV=development                           # must be production when APP_ENV=prod|dr · req:all · sens:C
APP_PRODUCT=LDC                                # Product code (fixed) · req:all · sens:C
APP_NAME=lawdocscomply-api                     # Process name for logs / OTel service.name · req:all · sens:C
APP_VERSION=0.0.0-local                        # Set by CI from Changesets; shown in /health and Settings › About · req:all · sens:C
APP_GIT_SHA=local                              # Commit SHA from CI · req:all · sens:C
APP_PORT=4000                                  # HTTP listen port · req:all · sens:C
APP_HOST=0.0.0.0                               # Bind address · req:all · sens:C
APP_BASE_URL=http://localhost:4000             # API base URL; https and host-map match in prod (IPB-11-18) · req:all · sens:C
APP_PUBLIC_URL=http://localhost:3000           # Public website (apps/public) · req:all · sens:C
APP_WEB_URL=http://localhost:3001              # Tenant app (apps/web) · req:all · sens:C
APP_CONSOLE_URL=http://localhost:3002          # Super-admin console (apps/console) · req:all · sens:C
APP_TRUST_PROXY=1                              # Trusted proxy hops · req:all · sens:C
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003  # Comma list · req:all · sens:C
APP_DEFAULT_TZ=Asia/Kolkata                    # Default time zone for schedules (regulatory scan 20:00 IST) · req:all · sens:C
APP_DEFAULT_LOCALE=en-IN                       # Default locale; hi-IN second locale per D-30 · req:all · sens:C
APP_REGION=ap-south-1                          # Cell label (ap-south-1 Mumbai; ap-south-2 Hyderabad DR) · req:all · sens:C
APP_CELL_ID=in-1                               # Regional cell id (P25 multi-region) · req:all · sens:C

# ---------- DB_ (PostgreSQL only; IPB-D-02; RLS enforced NN-01) ----------
DB_URL=postgres://app@localhost:5432/ldc       # Connection URL WITHOUT password · req:all · sens:C
DB_PASSWORD=app                                # Password (prod: secret://aws-sm/infrabyx/ldc/prod/db#password) · req:all · sens:S
DB_SSL_MODE=disable                            # disable|require|verify-full; verify-full in staging/prod/dr (IPB-11-19) · req:all · sens:C
DB_MIGRATIONS_ROLE=app_migrator                # Expand→migrate→contract role (P24 §4D) · req:all · sens:C
DB_MIGRATIONS_PASSWORD=migrator                # · req:all · sens:S
DB_RLS_BYPASS_ROLE=                            # Must be EMPTY in prod; break-glass via SECRETS only · req:opt · sens:S
DB_PGVECTOR_DIMS=1024                          # Embedding dimension of the notebook index (IPB-03-04) · req:all · sens:C
DB_EXTENSIONS_ALLOWLIST=pgcrypto,pg_trgm,pgvector,btree_gist,uuid-ossp  # migration-lint allow-list (P19 FR-P19-59) · req:all · sens:C

# ---------- CACHE_ / QUEUE_ (Redis, BullMQ) ----------
CACHE_REDIS_URL=redis://localhost:6379/0       # Cache and rate limits · req:all · sens:C
CACHE_REDIS_PASSWORD=                          # · req:prod · sens:S
QUEUE_REDIS_URL=redis://localhost:6379/1       # BullMQ · req:all · sens:C

# ---------- WORKFLOW_ (Temporal: compliance cycles, approvals, change releases, exports, return runs, missions) ----------
WORKFLOW_TEMPORAL_ADDRESS=localhost:7233       # · req:all · sens:C
WORKFLOW_TEMPORAL_NAMESPACE=ldc-local          # Per product per env · req:all · sens:C
WORKFLOW_TASK_QUEUE=ldc-main                   # · req:all · sens:C

# ---------- AUTH_ (IDENTITY_PORT; Keycloak reference, realms ldc and ldc-staff) ----------
AUTH_ADAPTER=keycloak                          # keycloak|entra|auth0|cognito · req:all · sens:C
AUTH_ISSUER_URL=http://localhost:8080/realms/ldc            # Customer realm; https in prod · req:all · sens:C
AUTH_STAFF_ISSUER_URL=http://localhost:8080/realms/ldc-staff # Staff realm (federated to group Entra ID) · req:all · sens:C
AUTH_CLIENT_ID=ldc-api                         # · req:all · sens:C
AUTH_CLIENT_SECRET=dev-secret                  # Refused literal in prod (IPB-11-17) · req:all · sens:S
AUTH_SESSION_COOKIE_NAME=__Host-ldc_sess       # · req:all · sens:C
AUTH_SESSION_SECRET=change-me-32-bytes-minimum # ≥32 bytes; refused in prod (IPB-11-17) · req:all · sens:S
AUTH_MFA_REQUIRED_ROLES=PLT_SUPER_ADMIN,PLT_SECURITY_OFFICER,PLT_RELEASE_MANAGER,ORG_OWNER,ten_admin,ten_cco  # Roles forced to MFA · req:all · sens:C
AUTH_PASSKEYS_RP_ID=localhost                  # WebAuthn RP ID · req:all · sens:C
AUTH_SUPER_ADMIN_EMAIL=rjnprajapati@gmail.com  # Bootstrap super admin (IPB-D-04); prod: invitation link only · req:all · sens:C

# ---------- AUTHZ_ / RULES_ (Cerbos; GoRules ZEN + CEL behind RULES_PORT) ----------
AUTHZ_CERBOS_URL=http://localhost:3592         # · req:all · sens:C
RULES_ADAPTER=gorules                          # gorules|cel · req:all · sens:C
RULES_GORULES_URL=http://localhost:3593        # · req:all · sens:C

# ---------- STORAGE_ (STORAGE_PORT; S3 reference with Object Lock, MinIO local) ----------
STORAGE_ADAPTER=s3                             # s3|azure_blob|gcs|minio · req:all · sens:C
STORAGE_REGION=ap-south-1                      # · req:all · sens:C
STORAGE_BUCKET_DOCS=ldc-docs-local             # DMS documents (Object Lock in prod) · req:all · sens:C
STORAGE_BUCKET_PUBLIC=ldc-public-local         # CMS media, resources renditions · req:all · sens:C
STORAGE_BUCKET_EXPORTS=ldc-exports-local       # LDC-EXPORT-1.0 packages · req:all · sens:C
STORAGE_BUCKET_LOGS=ldc-logs-local             # 180-day CERT-In logs (WORM) · req:all · sens:C
LDC_EVIDENCE_BUCKET=ldc-evidence-local         # Compliance evidence (Object Lock COMPLIANCE in prod) · req:all · sens:C
LDC_BOARDPACK_BUCKET=ldc-boardpacks-local      # Board packs and minutes (sealed classes; per-tenant keys) · req:all · sens:C
STORAGE_ACCESS_KEY_ID=minioadmin               # Prod uses IAM role; leave empty · req:nonprod · sens:S
STORAGE_SECRET_ACCESS_KEY=minioadmin           # · req:nonprod · sens:S
STORAGE_OBJECT_LOCK_MODE=GOVERNANCE            # GOVERNANCE|COMPLIANCE for docs; evidence uses COMPLIANCE · req:prod · sens:C
STORAGE_KMS_KEY_REF=                           # secret:// or ARN; per-tenant data keys derive from it · req:prod · sens:S
STORAGE_AV_SCAN_URL=http://localhost:3310      # ClamAV/ICAP for every upload (NN-30) · req:all · sens:C

# ---------- SEARCH_ (SEARCH_PORT; OpenSearch tenant-filtered indices, PostgreSQL FTS fallback) ----------
SEARCH_ADAPTER=pg_fts                          # pg_fts|opensearch · req:all · sens:C
SEARCH_OPENSEARCH_URL=                         # · req:opt · sens:C

# ---------- DOCGEN_ (DOCGEN_PORT; docxtemplater, redline engine, Gotenberg) ----------
DOCGEN_GOTENBERG_URL=http://localhost:3100     # PDF / PDF/A conversion · req:all · sens:C
DOCGEN_REDLINE_ENGINE_URL=http://localhost:3101 # Deterministic tracked-changes engine (NN-37) · req:all · sens:C

# ---------- SECRETS_ (SECRETS port) ----------
SECRETS_ADAPTER=env                            # env (local only)|aws_sm|azure_kv|gcp_sm|vault|sops · req:all · sens:C

# ---------- AI_ (packages/ai gateway + packages/vidhi kernel; IPB-03; P17 §4Y) ----------
AI_ENABLED=true                                # Master switch · req:all · sens:C
AI_DEFAULT_BAND_OPEN_ADAPTER=anthropic_direct  # PUBLIC/INTERNAL band · req:all · sens:C
AI_DEFAULT_BAND_IN_ZERO_ADAPTER=bedrock_claude_in  # CONFIDENTIAL/REGULATED band (IN-ZR floor; FR-P17-34 fail-closed) · req:all · sens:C
AI_DEFAULT_BAND_SELF_ADAPTER=self_hosted_vllm  # SEALED band · req:all · sens:C
AI_RESIDENCY_FLOOR_REGULATED=IN-ZR             # Locked for regulated plans (ai.routing.residency_floor) · req:all · sens:C
AI_ANTHROPIC_API_KEY=                          # anthropic_direct (public content only, X-03) · req:opt · sens:S
AI_BEDROCK_REGION=ap-south-1                   # Must be ap-south-1 (IPB-11-20) · req:all · sens:C
AI_OPENAI_API_KEY=                             # openai adapter (OFF until verified) · req:opt · sens:S
AI_AZURE_OPENAI_ENDPOINT=                      # azure_openai_in (OFF until verified) · req:opt · sens:C
AI_AZURE_OPENAI_REGION=centralindia            # Must be centralindia · req:opt · sens:C
AI_AZURE_OPENAI_API_KEY=                       # · req:opt · sens:S
AI_VERTEX_PROJECT_ID=                          # gemini_vertex_asia_south1 / gemini_imagen (OFF until verified) · req:opt · sens:C
AI_VERTEX_REGION=asia-south1                   # Must be asia-south1 · req:opt · sens:C
AI_VERTEX_SA_KEY_REF=                          # secret:// service-account JSON · req:opt · sens:S
AI_SARVAM_API_KEY=                             # sarvam (Indic; OFF until verified) · req:opt · sens:S
AI_BHASHINI_API_KEY=                           # · req:opt · sens:S
AI_VLLM_BASE_URL=http://localhost:8000/v1      # self_hosted_vllm (sealed band) · req:opt · sens:C
AI_IMAGE_ENABLED=false                         # IMAGE_GEN_PORT master switch (ai.image.enabled; D-74; owner #31) · req:all · sens:C
AI_IMAGE_DEFAULT_ADAPTER=gemini_imagen         # gemini_imagen|openai_images|stability|flux_replicate|flux_self_hosted · req:opt · sens:C
AI_C2PA_SIGNING_KEY_REF=                       # secret:// key for C2PA manifests on generated images (NN-63) · req:opt · sens:S
AI_SPEECH_DEFAULT_STT=bhashini                 # SPEECH_PORT default STT (meeting intelligence, type copies) · req:opt · sens:C
AI_EVAL_JUDGE_ADAPTER=bedrock_claude_in        # Judge for evals (never the model under test) · req:nonprod · sens:C
AI_PROVIDER_ROUTING_FILE=./infra/routing/ldc/local.routing.yaml  # provider_routing YAML (IPB-01 §01.4.5) · req:all · sens:C
VIDHI_SCHEDULES_PERMISSION_RECHECK=true        # Re-check scope at fire time (locked) · req:all · sens:C
VIDHI_MCP_SERVER_ENABLED=false                 # ldc-mcp (fut.mcp-server; per tenant) · req:all · sens:C

# ---------- PAYMENTS_ / BILLING_ (BILLING_PORT wraps PAYMENTS_PORT; OH8 engine of record, X-02) ----------
PAYMENTS_BILLING_ENGINE_URL=http://localhost:4100  # Operations Hub OH8 · req:all · sens:C
PAYMENTS_BILLING_ENGINE_TOKEN_REF=             # secret:// service token to OH8 · req:all · sens:S
PAYMENTS_ADAPTER=razorpay                      # razorpay|payu|cashfree|stripe (through OH8) · req:all · sens:C
PAYMENTS_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx     # Test prefix refused in prod (IPB-11-17); key secret and webhook secret live in OH8, not here (X-02) · req:opt · sens:C
PAYMENTS_HOSTED_CHECKOUT_ONLY=true             # Must be true (PCI DSS SAQ A) · req:all · sens:C

# ---------- MSG_ (MESSAGING_PORT = NOTIFY + SMS + WHATSAPP; X-71) ----------
MSG_EMAIL_ADAPTER=smtp                         # smtp|ses|sendgrid|postmark · req:all · sens:C
MSG_SMTP_HOST=localhost                        # MailHog locally · req:nonprod · sens:C
MSG_SMTP_PORT=1025                             # · req:nonprod · sens:C
MSG_EMAIL_FROM=no-reply@localhost              # Brand email identity in prod (brand_pack) · req:all · sens:C
MSG_EMAIL_DKIM_KEY_REF=                        # secret:// DKIM private key · req:prod · sens:S
MSG_SMS_ADAPTER=none                           # none|msg91|kaleyra|twilio (DLT-registered) · req:all · sens:C
MSG_SMS_DLT_ENTITY_ID=                         # TRAI DLT entity id · req:opt · sens:C
MSG_WHATSAPP_ADAPTER=none                      # none|meta_cloud|bsp; super-admin toggle msg.whatsapp.enabled · req:all · sens:C
MSG_WHATSAPP_ACCESS_TOKEN_REF=                 # secret:// (phone-number id and verify token are stored beside it in the vault) · req:opt · sens:S
MSG_WEBHOOK_SIGNING_SECRET_REF=                # secret:// Standard Webhooks outbound signing key · req:all · sens:S

# ---------- WORKSPACE_ / CALENDAR_ / ESIGN_ (WORKSPACE_PORT, CALENDAR_PORT, ESIGN_PORT) ----------
WORKSPACE_MS_GRAPH_TENANT_ID=                  # Microsoft 365 app registration (D-10; owner #1) · req:opt · sens:C
WORKSPACE_MS_GRAPH_CLIENT_ID=                  # · req:opt · sens:C
WORKSPACE_MS_GRAPH_CLIENT_SECRET_REF=          # secret:// · req:opt · sens:S
CALENDAR_ICS_FEED_SECRET_REF=                  # secret:// HMAC for ICS subscription URLs · req:all · sens:S
ESIGN_ADAPTER=none                             # none|asp_a|asp_b|dsc (CCA-empanelled ESPs via ASP, X-04) · req:all · sens:C
ESIGN_API_KEY_REF=                             # secret:// · req:opt · sens:S

# ---------- LDC_ (product-specific: regulatory feeds, company data, law register, exports) ----------
LDC_REGULATOR_FEEDS=./fixtures/feeds/rbi.json,./fixtures/feeds/sebi.json,./fixtures/feeds/mca.json  # Comma list; local = fixtures, never live sites (IPB-11 LDC note) · req:all · sens:C
LDC_FEED_POLL_MIN=1440                         # Daily regulatory scan at 20:00 IST (P05) · req:all · sens:C
LDC_COMPANY_DATA_ADAPTER=none                  # none|provider_a|provider_b (licensed MCA/GST data; owner #24; no scraping) · req:all · sens:C
LDC_COMPANY_DATA_API_KEY_REF=                  # secret:// · req:opt · sens:S
LDC_PAN_VERIFY_ADAPTER=none                    # Licensed PAN verification (P01, P18 §4W) · req:all · sens:C
LDC_LAW_REGISTER_PROVIDER_ENABLED=true         # LDC serves LAW_REGISTER_PORT to the group (P18 FR-P18-118) · req:all · sens:C
LDC_LAW_REGISTER_SNAPSHOT_PATH=./data/law-register/snapshot.json  # Product-local fallback snapshot · req:all · sens:C
LDC_EXPORT_FORMAT_VERSION=LDC-EXPORT-1.0       # Export package contract (NN-10) · req:all · sens:C
LDC_GOLDEN_EXPORT_PATH=./tests/golden/ldc-export # Golden archive for release diff (P19 §5.6) · req:nonprod · sens:C
LDC_HC_LOOKUP_ENABLED=false                    # Health Check anonymous company lookup (web.hc.lookup.enabled; OI-P23-04) · req:all · sens:C

# ---------- WEB_ / CMS_ / BRAND_ / MKT_ (apps/public, Studio, Brand Studio, marketing tooling; IPB-04) ----------
WEB_BRAND_PACK_SOURCE=db                       # db|ops_hub — where brand_pack is read from · req:all · sens:C
WEB_HOSTS_ALLOWLIST=localhost:3000,localhost:3001,localhost:3002  # Served hosts until brand_pack hosts are verified (LDC-WEB-054) · req:all · sens:C
WEB_INVESTORS_ENABLED=false                    # web.investors.enabled default (owner #29) · req:all · sens:C
WEB_BLOG_USER_POSTS_ENABLED=false              # web.blog.user_posts.enabled default (owner #30) · req:all · sens:C
WEB_MEDIA_SVG_MODE=rasterise                   # rasterise|sanitise_strict (locked) · req:all · sens:C
WEB_EMBED_ALLOWLIST=youtube-nocookie.com,player.vimeo.com  # Click-to-load, consent-gated embeds only · req:all · sens:C
WEB_SSRF_ALLOWLIST=                            # Hosts the server may fetch for link previews/imports (empty = none) · req:all · sens:C
MKT_TAG_MANAGER_ADAPTER=none                   # none|gtm_web|server_side (NN-62; owner #30) · req:all · sens:C
MKT_ANALYTICS_ADAPTER=none                     # none|plausible|umami|matomo (first-party, India-hosted) · req:all · sens:C
MKT_SENSITIVE_ROUTES=/health-check/*/answers,/grievance,/legal/*,/app/*,/console/*  # Never any tag here (locked) · req:all · sens:C

# ---------- TRUST_ / IPB_ (Vendor Assurance Room mirror; Ecosystem Spec v1.2 bus; Operations Hub) ----------
IPB_ECOSYSTEM_BUS_URL=nats://localhost:4222    # Cross-product CloudEvents bus (int module only, X-01) · req:all · sens:C
IPB_ECOSYSTEM_BUS_CREDS_REF=                   # secret:// NATS creds · req:prod · sens:S
IPB_OPS_HUB_URL=http://localhost:4100          # Operations Hub API (CRM, HR, vendor assurance, consent) · req:all · sens:C
IPB_OPS_HUB_TOKEN_REF=                         # secret:// service token · req:all · sens:S
IPB_TRUST_CENTRE_FEED_URL=                     # OH14.6 Vendor Assurance Room feed (TRUST_PORT) · req:opt · sens:C
IPB_DATA_RESIDENCY=IN                          # Declared residency of this deployment · req:all · sens:C
IPB_CERTIN_REPORT_EMAIL=                       # Incident reporting mailbox (runbook) · req:prod · sens:C

# ---------- OBS_ (OpenTelemetry, errors, logs; PII scrubbing NN-32) ----------
OBS_OTLP_ENDPOINT=http://localhost:4318        # · req:all · sens:C
OBS_SERVICE_NAMESPACE=infrabyx                 # · req:all · sens:C
OBS_TRACE_SAMPLE_RATIO=1.0                     # 0.1 in prod · req:all · sens:C
OBS_LOG_LEVEL=debug                            # info in prod · req:all · sens:C
OBS_LOG_FORMAT=pretty                          # json in prod · req:all · sens:C
OBS_LOG_RETENTION_DAYS=180                     # CERT-In minimum · req:all · sens:C
OBS_AUDIT_HASH_CHAIN_KEY_REF=                  # secret:// HMAC key for the audit ledger chain (NN-45) · req:all · sens:S

# ---------- FLAGS_ (FEATURE_FLAG_PORT; OpenFeature) ----------
FLAGS_ADAPTER=file                             # file|unleash|flagsmith · req:all · sens:C
FLAGS_FILE_PATH=./config/flags.local.json      # Local flags incl. fut.* defaults (master §5.6) · req:nonprod · sens:C

# ---------- ENG_ (IPB-09: previews, rings, release notes) ----------
ENG_PREVIEW_ENV=false                          # true inside a per-PR preview (noindex, staff IdP, TTL) · req:opt · sens:C
ENG_RELEASE_RING=internal                      # internal|beta|general · req:all · sens:C

# ---------- SEED_ (non-production only; NN-61) ----------
SEED_ENABLED=true                              # MUST be false/unset in prod/dr (exit 78) · req:nonprod · sens:C
SEED_PROFILE=dev                               # dev|demo|test|load; MUST be unset in prod/dr · req:nonprod · sens:C
SEED_RANDOM_SEED=20261026                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./env/SEED_CREDENTIALS.md # Gitignored; never printed · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/ldc/local/seed  # Seed vault path · req:nonprod · sens:C
SEED_DEMO_TENANT=demo-co-nbfc                  # "Demo Co" fictitious NBFC-ML (IPB-11 §11.4.8) · req:nonprod · sens:C

# ---------- Browser-exposed (apps/web, apps/public, apps/console, apps/delivery) ----------
NEXT_PUBLIC_APP_ENV=local                      # · req:all · sens:P
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000 # · req:all · sens:P
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/ldc  # · req:all · sens:P
NEXT_PUBLIC_AUTH_CLIENT_ID=ldc-web             # Public client · req:all · sens:P
NEXT_PUBLIC_PRODUCT=LDC                        # · req:all · sens:P
NEXT_PUBLIC_APP_NAME=LawDocsComply             # brand.app_name fallback before brand_pack loads · req:all · sens:P
NEXT_PUBLIC_CMP_ENABLED=true                   # Cookie consent manager · req:all · sens:P
NEXT_PUBLIC_ANALYTICS_ID=                      # Consent-gated; never on authenticated routes (NN-62) · req:opt · sens:P
