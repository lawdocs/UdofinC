############################################################
# Infrabyx EQ (Equator Resolution) — environment template (generated by pnpm env:example; do not edit by hand)
# IPB-11 v1.0 · Equator Build Prompt Pack v3.2 (26 October 2026)
# Secrets (sens:S) MUST be secret:// references in staging/demo/prod/dr (IPB-11-15).
# Legend per line: req:all|nonprod|prod|opt · sens:C (config) | S (secret) | P (public, browser-exposed)
# Equator-specific guard-rails: AI adapters for case content must be IN-resident (FR-P11-07, IPB-11-20);
# STORAGE_OBJECT_LOCK_MODE=COMPLIANCE for the recordings bucket even in staging (IPB-11 EQ note);
# SEED_* unset in prod/dr (IPB-11-14); PAYMENTS_HOSTED_CHECKOUT_ONLY=true always (NN-31).
# 221 variables (count re-verified at the 26 Oct 2026 independent review; earlier text said 219): Equator carries 35+ provider ports (master §4.4), so the count exceeds the IPB-11 100–160 guide (recorded as IPB-DEV-02).
# Optional provider keys for adapters registered 'disabled' (OpenAI/Azure, Vertex, xAI beyond the one line, Cashfree, Stripe, PayU,
# Brevo, M365 client credentials, Unleash, GTM container) are added by `pnpm env:example --with-optional` when the adapter is contracted.
############################################################

# ---------- APP_ (process identity, URLs) ----------
APP_ENV=local                                  # local|dev|test|staging|uat|demo|prod|dr · req:all · sens:C
NODE_ENV=development                           # production when APP_ENV=prod|dr · req:all · sens:C
NODE_VERSION_EXPECTED=24.22.1                  # Boot asserts process.version (IPB-D-01; D3-48) · req:all · sens:C
APP_PRODUCT=EQ                                 # Product code · req:all · sens:C
APP_NAME=equator-api                           # OTel service.name (equator-api | equator-worker | equator-web | equator-ops) · req:all · sens:C
APP_VERSION=0.0.0-local                        # Set by CI (rel-YYYY.MM.DD-N) · req:all · sens:C
APP_GIT_SHA=local                              # Commit SHA · req:all · sens:C
APP_PORT=4000                                  # API listen port · req:all · sens:C
APP_HOST=0.0.0.0                               # Bind address · req:all · sens:C
APP_BASE_URL=http://localhost:4000             # API base; https + host map in prod · req:all · sens:C
APP_PUBLIC_URL=http://localhost:3000           # Public site + portals (apps/web) · req:all · sens:C
APP_OPS_URL=http://localhost:3002              # Operations Platform (apps/ops; ops.equatorresolution.in in prod) · req:all · sens:C
APP_ADMIN_URL=http://localhost:3003            # Super-admin console (admin.equatorresolution.in) · req:all · sens:C
APP_TRUST_PROXY=1                              # Trusted proxy hops · req:all · sens:C
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003  # · req:all · sens:C
APP_DEFAULT_TZ=Asia/Kolkata                    # Clocks and display default · req:all · sens:C
APP_DEFAULT_LOCALE=en-IN                       # en-IN | hi-IN at launch (NN-23) · req:all · sens:C
APP_REGION=ap-south-1                          # ap-south-1 primary; ap-south-2 DR · req:all · sens:C
APP_CASE_NUMBER_PREFIX=EQ                      # EQ/{VERT}/{CITY}/{YYYY}/{NNNNN} · req:all · sens:C
APP_REQUEST_BODY_LIMIT_MB=50                   # Bundles and evidence uploads · req:opt · sens:C
APP_MAINTENANCE_MODE=false                     # 503 except health; outage banner per FR-P14-22 · req:opt · sens:C

# ---------- DB_ (PostgreSQL only; IPB-D-02; Aurora PostgreSQL is the reference adapter, not a dependency) ----------
DB_ADAPTER=postgres                            # postgres (Aurora, RDS, Azure Flexible, Cloud SQL, Supabase non-prod all use this) · req:all · sens:C
DB_URL=postgres://app@localhost:5432/equator   # Core (case plane) URL WITHOUT password · req:all · sens:C
DB_PASSWORD=app                                # · req:all · sens:S (prod: secret://aws-sm/infrabyx/eq/prod/db#password)
DB_SSL_MODE=disable                            # verify-full in staging/prod/dr · req:all · sens:C
DB_MIGRATIONS_ROLE=app_migrator                # expand→migrate→contract role · req:all · sens:C
DB_MIGRATIONS_PASSWORD=migrator                # · req:all · sens:S
DB_RLS_BYPASS_ROLE=                            # EMPTY in prod; break-glass via SECRETS only · req:opt · sens:S
DB_PGVECTOR_DIMS=1024                          # Embedding dimension (P11 FR-P11-08 bake-off) · req:all · sens:C
DB_BUSINESS_URL=postgres://app@localhost:5433/equator_business  # Isolated business DB (growth, ops, mkt — D3-20) · req:all · sens:C
DB_BUSINESS_PASSWORD=app                       # · req:all · sens:S
DB_SEALED_URL=postgres://app@localhost:5434/equator_sealed      # Sealed stores (posh_sealed, health_sealed, safety_sealed — NN-07) · req:all · sens:C
DB_SEALED_PASSWORD=app                         # · req:all · sens:S
DB_SEALED_KMS_KEY_REF=                         # Separate KMS key for sealed stores · req:prod · sens:S

# ---------- CACHE_ / QUEUE_ (Redis, BullMQ) ----------
CACHE_REDIS_URL=redis://localhost:6379/0       # · req:all · sens:C
CACHE_REDIS_TLS=false                          # true in prod · req:all · sens:C
QUEUE_REDIS_URL=redis://localhost:6379/1       # · req:all · sens:C

# ---------- WORKFLOW_ (Temporal) ----------
WORKFLOW_TEMPORAL_ADDRESS=localhost:7233       # · req:all · sens:C
WORKFLOW_TEMPORAL_NAMESPACE=eq-local           # per product per env · req:all · sens:C
WORKFLOW_TASK_QUEUE=eq-main                    # · req:all · sens:C
WORKFLOW_TASK_QUEUE_VIDHI=eq-vidhi             # P22 kernel tasks and schedules · req:all · sens:C

# ---------- AUTH_ (IDENTITY; Keycloak reference) ----------
AUTH_ADAPTER=keycloak                          # keycloak|zitadel|entra · req:all · sens:C
AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-eq  # https in prod · req:all · sens:C
AUTH_CLIENT_ID=eq-api                          # · req:all · sens:C
AUTH_CLIENT_SECRET=dev-secret                  # refused literal in prod · req:all · sens:S
AUTH_CLIENT_ID_OPS=eq-portal-ops               # Staff client; phishing-resistant MFA (X-24) · req:all · sens:C
AUTH_SESSION_COOKIE_NAME=__Host-eq_sess        # · req:all · sens:C
AUTH_SESSION_SECRET=change-me-32-bytes-minimum # ≥32 bytes · req:all · sens:S
AUTH_SESSION_TTL_MIN=480                       # · req:opt · sens:C
AUTH_MFA_REQUIRED_ROLES=platform_admin,registrar,quality_officer,dpo,institution_admin,finance_controller  # · req:all · sens:C
AUTH_STEP_UP_ACTIONS=sign,payout,config_change,sealed_access,award_issue  # Step-up MFA actions (master §4.1) · req:all · sens:C
AUTH_PASSKEYS_RP_ID=localhost                  # · req:all · sens:C
AUTH_PASSKEYS_ORIGINS=http://localhost:3000    # fut.passkeys-default related origins · req:all · sens:C
AUTH_CONTEXT_HEADER=Equator-Context            # Signed tenant/role/case header (X-01) · req:all · sens:C
AUTH_CONTEXT_SIGNING_KEY_REF=                  # secret:// gateway signing key · req:all · sens:S
AUTH_SUPER_ADMIN_EMAIL=rjnprajapati@gmail.com  # Bootstrap super admin (IPB-D-04) · req:all · sens:C
AUTH_BREAK_GLASS_ENABLED=false                 # false in prod · req:opt · sens:C
AUTH_DIGILOCKER_PARTNER_ADAPTER=none           # none|surepass — party login via licensed partner (D2-06) · req:all · sens:C

# ---------- AUTHZ_ / RULES_ ----------
AUTHZ_CERBOS_URL=http://localhost:3592         # · req:all · sens:C
RULES_ADAPTER=gorules                          # gorules|cel · req:all · sens:C
RULES_GORULES_URL=http://localhost:3593        # Routing, clocks, fees evaluators (NN-01 deterministic) · req:all · sens:C
RULES_HOLIDAY_CALENDAR_SOURCE=packages/rules/calendars  # Indian holiday calendars per state · req:all · sens:C

# ---------- STORAGE_ (STORAGE port; S3 reference, MinIO local) ----------
STORAGE_ADAPTER=s3                             # s3|minio|azure_blob|gcs · req:all · sens:C
STORAGE_ENDPOINT=http://localhost:9000         # MinIO local; empty for AWS · req:nonprod · sens:C
STORAGE_REGION=ap-south-1                      # · req:all · sens:C
STORAGE_BUCKET_DOCS=eq-docs-local              # Case documents (Object Lock in prod) · req:all · sens:C
STORAGE_BUCKET_EVIDENCE=eq-evidence-local      # Evidence ledger objects, COMPLIANCE lock (NN-22) · req:all · sens:C
STORAGE_BUCKET_RECORDINGS=eq-recordings-local  # Hearing recordings, REGULATED; COMPLIANCE lock even in staging · req:all · sens:C
STORAGE_BUCKET_PUBLIC=eq-public-local          # CMS media, brand assets · req:all · sens:C
STORAGE_BUCKET_EXPORTS=eq-exports-local        # EQ-EXPORT-1.0 packages · req:all · sens:C
STORAGE_BUCKET_LOGS=eq-logs-local              # 180-day CERT-In logs (WORM) · req:all · sens:C
STORAGE_BUCKET_BACKUP_VAULT=                   # Air-gapped vault account eq-backup (X-66(d)) · req:prod · sens:C
STORAGE_ACCESS_KEY_ID=minioadmin               # prod: IAM role, leave empty · req:nonprod · sens:S
STORAGE_SECRET_ACCESS_KEY=minioadmin           # · req:nonprod · sens:S
STORAGE_OBJECT_LOCK_MODE=COMPLIANCE            # Evidence and recordings buckets · req:prod · sens:C
STORAGE_RECORDING_PRESIGN_TTL_S=120            # Time-boxed recording URLs (IPB-10 EQ note) · req:all · sens:C
STORAGE_KMS_KEY_REF=                           # Per-tenant data keys root (BYOK option) · req:prod · sens:S
STORAGE_AV_SCAN_URL=http://localhost:3310      # ClamAV (AV port) · req:all · sens:C

# ---------- SEARCH_ / VECTOR_ ----------
SEARCH_ADAPTER=opensearch                      # pg_fts|opensearch · req:all · sens:C
SEARCH_OPENSEARCH_URL=http://localhost:9200    # Tenant-scoped aliases; sealed never indexed · req:opt · sens:C
VECTOR_ADAPTER=pgvector                        # pgvector (HNSW) · req:all · sens:C

# ---------- DOCGEN_ / PDF_ ----------
DOCGEN_GOTENBERG_URL=http://localhost:3001     # DOCX/PDF conversion · req:all · sens:C
DOCGEN_PDFA_ENABLED=true                       # PDF/A for awards, settlements, exports (NN-37) · req:opt · sens:C
DOCGEN_SC_A4_PROFILE=verified                  # Supreme Court A4 print profile status (X-34) · req:all · sens:C

# ---------- SECRETS_ ----------
SECRETS_ADAPTER=env                            # env (local)|aws_sm|azure_kv|gcp_sm|vault · req:all · sens:C
SECRETS_AWS_REGION=ap-south-1                  # · req:prod · sens:C

# ---------- AI_ (packages/ai gateway + packages/vidhi kernel; IPB-03; P11, P22) ----------
AI_ENABLED=true                                # Master switch (platform.ai.kill.all inverse) · req:all · sens:C
AI_DEFAULT_BAND_OPEN_ADAPTER=bedrock_claude_in # PUBLIC/INTERNAL band — still IN by Equator policy · req:all · sens:C
AI_DEFAULT_BAND_IN_ZERO_ADAPTER=bedrock_claude_in  # CONFIDENTIAL/REGULATED band (FR-P11-07) · req:all · sens:C
AI_DEFAULT_BAND_SELF_ADAPTER=                  # SECRET band unused in EQ (sealed never reaches AI) · req:opt · sens:C
AI_BEDROCK_REGION=ap-south-1                   # Must be ap-south-1 (IPB-11-20) · req:all · sens:C
AI_BEDROCK_INFERENCE_PROFILE=in.anthropic.claude  # India geographic profile (Mumbai+Hyderabad) · req:all · sens:C
AI_ANTHROPIC_API_KEY=                          # anthropic_direct: PUBLIC corpus jobs only, OFF by default · req:opt · sens:S
AI_XAI_API_KEY=                                # xai_grok registered disabled (P22 §14 item 2) · req:opt · sens:S
AI_SARVAM_API_KEY=                             # Indic STT/TTS/translate/OCR · req:opt · sens:S
AI_EMBEDDING_ADAPTER=bedrock_titan_v2          # bedrock_titan_v2|bedrock_cohere_multilingual (in-Region) · req:all · sens:C
AI_IMAGE_ENABLED=false                         # IMAGE_GEN OFF until owner decision (IPB open item 6) · req:all · sens:C
AI_SPEECH_DEFAULT_STT=sarvam                   # sarvam|bhashini · req:opt · sens:C
AI_SPEECH_DEFAULT_TTS=sarvam                   # · req:opt · sens:C
AI_OCR_ADAPTER=sarvam_vision                   # sarvam_vision|textract_in (ocr.regional_cloud OFF) · req:all · sens:C
AI_OBS_CAPTURE_CONTENT=false                   # never true in prod · req:all · sens:C
AI_RELEVANCE_FLOOR=0.35                        # RAG abstain threshold (P11 FR-P11-15) · req:opt · sens:C
AI_MCP_SERVER_ENABLED=false                    # Vidhi MCP server (P22 FR-P22-21); tenant setting overrides down only · req:all · sens:C
AI_MCP_OAUTH_RESOURCE=urn:infrabyx:eq:mcp      # OAuth 2.1 resource indicator · req:opt · sens:C
AI_A2A_AGENT_CARD=false                        # fut.a2a-agent-card · req:all · sens:C
VIDHI_PRODUCT_CEILING=L2                       # Locked product ceiling (FR-P22-10); boot asserts L2 · req:all · sens:C
VIDHI_PERSONA_VERSION=vidhi.persona@1+eq@1     # · req:all · sens:C
VIDHI_NOTEBOOK_EGRESS_PROXY_URL=http://localhost:3128  # EGRESS allow-listed proxy for URL sources · req:all · sens:C

# ---------- PAYMENTS_ / ESCROW_ (IPB-D-07; NN-13, NN-31) ----------
PAYMENTS_ADAPTER=razorpay                      # razorpay|cashfree · req:all · sens:C
PAYMENTS_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx     # test prefix refused in prod · req:opt · sens:C
PAYMENTS_RAZORPAY_KEY_SECRET=                  # · req:opt · sens:S
PAYMENTS_RAZORPAY_WEBHOOK_SECRET=              # · req:opt · sens:S
PAYMENTS_INTL_ADAPTER=none                     # none|razorpay_intl|stripe|paypal (INT) · req:opt · sens:C
PAYMENTS_HOSTED_CHECKOUT_ONLY=true             # Must be true (PCI DSS SAQ A; NN-31) · req:all · sens:C
PAYMENTS_SPLIT_SETTLEMENT=true                 # Route splits for neutral fees (NN-13) · req:all · sens:C
PAYMENTS_BILLING_ENGINE_URL=http://localhost:4100  # OH8 billing engine of record · req:all · sens:C
PAYMENTS_BILLING_ENGINE_TOKEN_REF=             # secret:// · req:all · sens:S
PAYOUT_ADAPTER=razorpayx                       # razorpayx|bank_file · req:all · sens:C
ESCROW_ADAPTER=none                            # none|castler|razorpayx_escrow — settlement sums never via merchant a/c · req:all · sens:C
ESCROW_API_KEY_REF=                            # secret:// · req:opt · sens:S

# ---------- ESIGN_ / ESTAMP_ / KYC_ (D §D.3) ----------
ESIGN_ADAPTER=leegality                        # leegality|digio|signdesk|fake · req:all · sens:C
ESIGN_API_KEY_REF=                             # secret:// · req:opt · sens:S
ESTAMP_ADAPTER=leegality_bharatstamp           # leegality_bharatstamp|digio|signdesk_nesl|fake · req:all · sens:C
ESTAMP_API_KEY_REF=                            # secret:// · req:opt · sens:S
KYC_ADAPTER=surepass                           # surepass|idfy|signzy|fake — Aadhaar offline only (NN-14) · req:all · sens:C
KYC_API_KEY_REF=                               # secret:// · req:opt · sens:S
SANCTIONS_ADAPTER=none                         # none|provider|manual_list (INT, NN-19) · req:opt · sens:C

# ---------- MSG_ (NOTIFY: email, SMS, WhatsApp, push, postal) ----------
MSG_EMAIL_ADAPTER=smtp                         # smtp|ses|resend · req:all · sens:C
MSG_SMTP_HOST=localhost                        # MailHog locally · req:nonprod · sens:C
MSG_SMTP_PORT=1025                             # · req:nonprod · sens:C
MSG_EMAIL_FROM=no-reply@localhost              # brand email identity in prod (SPF/DKIM/DMARC verified) · req:all · sens:C
MSG_EMAIL_DKIM_KEY_REF=                        # secret:// · req:prod · sens:S
MSG_SMS_ADAPTER=none                           # none|msg91|gupshup|kaleyra · req:all · sens:C
MSG_SMS_API_KEY_REF=                           # secret:// · req:opt · sens:S
MSG_SMS_DLT_ENTITY_ID=                         # TRAI DLT Principal Entity (M-05) · req:opt · sens:C
MSG_WHATSAPP_ADAPTER=none                      # none|gupshup|meta_cloud|interakt · req:all · sens:C
MSG_WHATSAPP_ACCESS_TOKEN_REF=                 # secret:// · req:opt · sens:S
MSG_WHATSAPP_ENABLED_SUPERADMIN=false          # Super-admin master toggle (IPB-04/10) · req:all · sens:C
MSG_CONTACT_WINDOW_FLOOR=08:00-19:00           # Locked NN-12 floor; microfinance 09:00-18:00 applied by rule pack · req:all · sens:C
MSG_PUSH_ADAPTER=expo                          # expo|fcm_apns_direct · req:all · sens:C
MSG_POSTAL_ADAPTER=manual                      # manual|india_post_api (POSTAL_PORT, X-02) · req:all · sens:C
MSG_WEBHOOK_SIGNING_SECRET_REF=                # secret:// Standard Webhooks outbound · req:all · sens:S

# ---------- VOICE_ / TELEPHONY_ / VIDEO_ (P04, P07) ----------
VOICE_ADAPTER=none                             # none|elevenlabs|sarvam|livekit_agents · req:all · sens:C
TELEPHONY_ADAPTER=none                         # none|exotel|plivo · req:all · sens:C
VIDEO_ADAPTER=livekit                          # livekit (self-hosted or Cloud India)|hundredms · req:all · sens:C
VIDEO_LIVEKIT_URL=ws://localhost:7880          # · req:all · sens:C
VIDEO_LIVEKIT_API_KEY=devkey                   # · req:all · sens:C
VIDEO_LIVEKIT_API_SECRET=change-me-dev-only    # Literal refused in prod (IPB-11-17) · req:all · sens:S
VIDEO_RECORDING_DEFAULT=off                    # Mediation never recorded (NN-11) · req:all · sens:C
VIDEO_LIVE_CAPTIONS_ADAPTER=sarvam             # Consented, ephemeral captions (IPB-06-08) · req:opt · sens:C
INTERPRETER_ADAPTER=internal_roster            # ISL/language interpreter booking (INTERPRETER port) · req:all · sens:C

# ---------- WORKSPACE_ / STORAGE_SYNC_ / ACCOUNTING_ (P21; AC) ----------
WORKSPACE_ADAPTER=none                         # none|m365_graph|manual_it_desk (Google OFF — D3-40) · req:all · sens:C

# ---------- CRM_ / MARKETING_ / SOCIAL_ / ANALYTICS_ / TAG_MANAGER_ (P13, P16, P17; Y) ----------
CRM_ADAPTER=internal                           # internal (ops.crm_* system of record)|brevo|hubspot|zoho · req:all · sens:C
MARKETING_ADAPTER=none                         # none|brevo · req:all · sens:C
SOCIAL_ADAPTER=manual_handoff                  # manual_handoff|platform adapters OFF · req:all · sens:C
ANALYTICS_ADAPTER=posthog                      # posthog (self-hosted)|ga4|matomo|none — consent-gated · req:all · sens:C
ANALYTICS_POSTHOG_KEY=                         # · req:opt · sens:S
TAG_MANAGER_ADAPTER=none                       # none|gtm_web|gtm_server (IPB-04-85; owner decision IPB open item 5) · req:all · sens:C
PIXELS_BLOCKED_ROUTE_TAGS=case,hearing,grievance,posh,payment,sealed,fam,health  # Y ML-10 locked list · req:all · sens:C
EXPERIMENTS_ADAPTER=growthbook                 # growthbook|none · req:opt · sens:C

# ---------- CMS_ / BRAND_ / HLP_ / TRUST_ / FEEDBACK_ (shared packages; IPB-04, 07, 08) ----------
CMS_ADAPTER=payload                            # payload (editor runtime on cms schema; IPB-DEV-04)|studio · req:all · sens:C
CMS_PAYLOAD_SECRET=                            # · req:all · sens:S
CMS_LAW_REGISTER_URL=                          # LAW_REGISTER port (stale-citation lint; Appendix G snapshot fallback) · req:opt · sens:C
BRAND_DEFAULT_PACK_ID=brd_eq_default           # Equator default brand pack (teal/coral/Manrope) · req:all · sens:C
HLP_LINT_STRICT=true                           # hlp-lint fails on missing help key (IPB-07-43) · req:all · sens:C
TRUST_ADAPTER=oh14_6                           # oh14_6 (OH14.6 system of record)|mirror_readonly · req:all · sens:C
FEEDBACK_SUPPORT_ADAPTER=oh6                   # oh6|internal_tickets (SUPPORT port) · req:all · sens:C
FEEDBACK_BACKLOG_ADAPTER=github_issues         # oh_backlog|github_issues|linear (BACKLOG port) · req:all · sens:C
FEEDBACK_IDEA_BOARD_ENABLED=false              # fb.idea_board.enabled seed · req:all · sens:C
HR_ADAPTER=oh10                                # Careers applications → OH10 (HR port) · req:all · sens:C
CONSENT_ADAPTER=internal                       # internal|consent_manager (DPDP CM from 13 Nov 2026) · req:all · sens:C
EGRESS_PROXY_URL=http://localhost:3128         # Allow-listed outbound proxy (SSRF guard) · req:all · sens:C
EGRESS_ALLOWLIST_PATH=./config/egress.allow.json  # · req:all · sens:C
REGWATCH_ADAPTER=internal_feed                 # Regulatory-watch feed (Appendix V) · req:all · sens:C
REGISTRY_ADAPTER=none                          # none|grp_registry (Infrabyx Professional Registry consumer, NN-39) · req:all · sens:C

# ---------- CONNECTOR_ (government and ecosystem; GOV/GROUP ports) ----------
CONNECTOR_SMART_ODR_ENABLED=false              # SEBI SMART ODR (flag OFF; fut.sebi-odr-v2) · req:all · sens:C
CONNECTOR_ECOURTS_ADAPTER=none                 # none|surepass_cnr|ecourts_api (fut.ecourts-api) · req:all · sens:C
EQ_SCHEME_CONFIG_PATH=./config/schemes/        # Scheme-as-data files incl. SEBI-style DRAFT (IPB-11 EQ note) · req:all · sens:C

# ---------- OBS_ (OpenTelemetry, errors, logs) ----------
OBS_OTLP_ENDPOINT=http://localhost:4318        # · req:all · sens:C
OBS_OTLP_INSECURE=true                         # in-cluster only · req:opt · sens:C
OBS_SERVICE_NAMESPACE=infrabyx                 # · req:all · sens:C
OBS_TRACE_SAMPLE_RATIO=1.0                     # 0.1 prod · req:all · sens:C
OBS_LOG_LEVEL=debug                            # info in prod · req:all · sens:C
OBS_LOG_FORMAT=pretty                          # json in prod · req:all · sens:C
OBS_PII_REDACTION=true                         # Redaction middleware always on (master §4.4) · req:all · sens:C
OBS_ERRORS_DSN=                                # Sentry-compatible · req:opt · sens:S
OBS_LOG_RETENTION_DAYS=180                     # CERT-In minimum · req:all · sens:C
OBS_AUDIT_HASH_CHAIN_KEY_REF=                  # secret:// HMAC for hash-chained audit (NN-22) · req:all · sens:S

# ---------- FLAGS_ (OpenFeature; Unleash self-hosted India) ----------
FLAGS_ADAPTER=file                             # file|unleash · req:all · sens:C
FLAGS_FILE_PATH=./config/flags.local.json      # · req:nonprod · sens:C
FLAGS_FUT_DEFAULT=off                          # Every fut.* flag seeded OFF (IPB-11-29) · req:all · sens:C

# ---------- IPB_ (shared cross-product; Ecosystem Spec) ----------
IPB_ECOSYSTEM_BUS_URL=nats://localhost:4222    # CloudEvents bus · req:all · sens:C
IPB_ECOSYSTEM_BUS_CREDS_REF=                   # secret:// · req:prod · sens:S
IPB_OPS_HUB_URL=http://localhost:4100          # Operations Hub (billing OH8, trust OH14.6, support OH6, HR OH10) · req:all · sens:C
IPB_OPS_HUB_TOKEN_REF=                         # secret:// · req:all · sens:S
IPB_BRAND_PACK_SOURCE=db                       # · req:all · sens:C
IPB_DATA_RESIDENCY=IN                          # · req:all · sens:C
IPB_CERTIN_REPORT_EMAIL=                       # 6-hour incident reporting mailbox · req:prod · sens:C
IPB_GROUP_SHARE_SCOPE_ENFORCED=true            # NN-38 CI/runtime guard (no case or allocation data to group) · req:all · sens:C

# ---------- SEED_ (non-production only) ----------
SEED_ENABLED=true                              # false/unset in prod/dr (exit 78) · req:nonprod · sens:C
SEED_PROFILE=dev                               # dev|demo|test|load; unset in prod/dr · req:nonprod · sens:C
SEED_RANDOM_SEED=20261026                      # Deterministic faker seed · req:nonprod · sens:C
SEED_CREDENTIALS_PATH=./env/SEED_CREDENTIALS.md  # gitignored · req:nonprod · sens:C
SEED_VAULT_PREFIX=secret://env/infrabyx/eq/local/seed  # · req:nonprod · sens:C
SEED_DEMO_NARRATIVE=three_cases                # one settled, one at hearing, one EU-party flagged (IPB-11 EQ note) · req:nonprod · sens:C

# ---------- Browser-exposed (apps/web, apps/ops, apps/docs-portal) ----------
NEXT_PUBLIC_APP_ENV=local                      # · req:all · sens:P
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000 # · req:all · sens:P
NEXT_PUBLIC_AUTH_ISSUER_URL=http://localhost:8080/realms/infrabyx-eq  # · req:all · sens:P
